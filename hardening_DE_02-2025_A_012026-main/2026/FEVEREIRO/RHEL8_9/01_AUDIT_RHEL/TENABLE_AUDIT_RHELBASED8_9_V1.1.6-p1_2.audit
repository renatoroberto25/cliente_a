<check_type:"Unix">

<custom_item>
  type        : CMD_EXEC
  description : "1 Desabilitar módulo cramfs"
  info        : "Alta"
  solution    : "Kernel Modules"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Light"
  cmd         : "((modinfo cramfs &>/dev/null && modprobe --showconfig | grep -Pq '\\b(install|blacklist)\\h+cramfs\\b' && ! lsmod | grep -q cramfs) || (! modinfo cramfs &>/dev/null) ) && echo \"PASS\" || echo \"FAIL\" "
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

