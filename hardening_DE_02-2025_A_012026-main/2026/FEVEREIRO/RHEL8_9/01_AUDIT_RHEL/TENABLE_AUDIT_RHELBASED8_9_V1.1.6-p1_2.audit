  solution    : "Senhas e Contas"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Light"
  cmd         : "( val=$(awk '\$1==\"PASS_MAX_DAYS\"{print \$2; exit}' /etc/login.defs 2>/dev/null); case \"$val\" in ''|*[!0-9]*) echo FAIL ;; *) [ \"$val\" -le 365 ] && echo PASS || echo FAIL ;; esac )"
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

