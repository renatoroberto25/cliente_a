  cmd         : "(grep -Eq '^[[:space:]]*(AllowUsers|DenyUsers|AllowGroups|DenyGroups)' /etc/ssh/sshd_config && echo \"PASS\"  || echo \"FAIL\" )"
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

