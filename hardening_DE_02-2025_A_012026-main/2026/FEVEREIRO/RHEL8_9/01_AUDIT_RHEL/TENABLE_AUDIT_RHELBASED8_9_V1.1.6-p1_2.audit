  type        : CMD_EXEC
  description : "103 Firewall com política default deny"
  info        : "Alta"
  solution    : "Rede Firewall"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Full"
  cmd         : "((iptables -L INPUT -n 2>/dev/null | grep -q 'policy DROP') && (iptables -L FORWARD -n 2>/dev/null | grep -q 'policy DROP') && (iptables -L OUTPUT -n 2>/dev/null | grep -q 'policy DROP')) && echo \"PASS\"  || echo \"FAIL\" "
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "104 Apenas uma solução de firewall ativa"
  info        : "Alta"
  solution    : "Rede Firewall"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Full"
  cmd         : "([ \"$(printf \"%s\n\" \"$(systemctl is-active firewalld >/dev/null 2>&1 && echo F)\" \"$(iptables -L >/dev/null 2>&1 && echo F)\" \"$(ip6tables -L >/dev/null 2>&1 && echo F)\" | grep -c F)\" -eq 1 ] && echo \"PASS\"  || echo \"FAIL\" )"
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "105 Regras básicas de firewall"
  info        : "Alta"
  solution    : "Rede Firewall"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Full"
  cmd         : "((iptables -L INPUT -n 2>/dev/null | grep -q 'lo .* ACCEPT') && (iptables -L INPUT -n | grep -Eq 'ESTABLISHED|RELATED') && (iptables -L OUTPUT -n | grep -q 'ACCEPT')) && echo \"PASS\"  || echo \"FAIL\" "
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "106 Regras explícitas para portas abertas"
  info        : "Alta"
  solution    : "Rede Firewall"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Full"
  cmd         : "(ss -tuln | awk 'NR>1 {print $5}' | sed 's/.*://g' | sort -u | grep -v '^$' | while read P; do iptables -L INPUT -n 2>/dev/null | grep -q \":${P} \" || exit 1; done && echo \"PASS\"  || echo \"FAIL\" )"
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "107 Regras de firewall persistentes"
  info        : "Média"
  solution    : "Rede Firewall"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Full"
  cmd         : "(iptables-save 2>/dev/null | grep -q . && echo \"PASS\"  || echo \"FAIL\" )"
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "108 TLS mínimo 1.2/1.3"
  info        : "Alta"
  solution    : "Criptografia TLS"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Full"
  cmd         : "((grep -Eq '(TLSv1\\.2|TLSv1\\.3)' /etc/crypto-policies/config 2>/dev/null) || (grep -Eq '(MinProtocol.*TLSv1\\.2|ssl_protocol.*TLSv1\\.2)' /etc/httpd/conf.d/* 2>/dev/null) || (grep -Eq '(ssl_protocol.*TLSv1\\.2)' /etc/nginx/* 2>/dev/null)) && echo \"PASS\"  || echo \"FAIL\" "
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "109 Permissoes seguras em sshd config e chaves"
  info        : "Alta"
  solution    : "SSH Hardening"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Light"
  cmd         : "stat -Lc '%a %U %G' /etc/ssh/sshd_config"
  expect      : "^[0-6]00 root root$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "110 Controle de acesso via Allow/Deny"
