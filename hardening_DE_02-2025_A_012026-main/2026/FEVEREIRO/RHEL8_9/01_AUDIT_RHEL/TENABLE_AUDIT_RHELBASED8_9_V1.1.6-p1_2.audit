  type        : CMD_EXEC
  description : "203 Ausencia de forward netrc rhosts"
  info        : "Alta"
  solution    : "Sistema e Contas"
  reference   : "BASELINE HITSS"
  see_also    : "Perfil: Full"
  cmd         : "( awk -F: '$3>=1000 && $1!=\"nfsnobody\"{print $6}' /etc/passwd | while read h; do [ -e \"$h/.forward\" ] || [ -e \"$h/.netrc\" ] || [ -e \"$h/.rhosts\" ] && exit 1; done ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\s*pass\s*$"
</custom_item>

#################################################################
#################################################################
#################################################################

<custom_item>
  type        : CMD_EXEC
  description : "Registro de baseline HITSS no host"
  info        : "Marca a aplicação do baseline HITSS e registra histórico no host"
  solution    : "Nenhuma ação necessária"
  reference   : "BASELINE HITSS"
  see_also    : "/var/lib/hitss/baseline.state ; /var/log/hitss-hardening.log"
  cmd         : "mkdir -p /var/lib/hitss && if [ ! -f /var/lib/hitss/baseline.state ]; then echo \"HITSS BASELINE=RHELBASED VERSION=1.1.5-p1 FIRST_APPLY=$(date -Iseconds) HOST=$(hostname)\" > /var/lib/hitss/baseline.state; echo \"$(date -Iseconds) | HITSS | BASELINE=RHELBASED | VERSION=1.1.5-p1 | FIRST_APPLY | HOST=$(hostname)\" >> /var/log/hitss-hardening.log; echo \"FIRST_APPLY\"; else echo \"$(date -Iseconds) | HITSS | BASELINE=RHELBASED | VERSION=1.1.5-p1 | REAPPLY | HOST=$(hostname)\" >> /var/log/hitss-hardening.log; cat /var/lib/hitss/baseline.state; fi"
  expect      : "(FIRST_APPLY|HITSS)"
</custom_item>

#################################################################
#################################################################
#################################################################

</check_type>
