<check_type:"Unix">

<custom_item>
  type        : CMD_EXEC
  description : "1 Desabilitar módulo cramfs"
  info        : "Alta"
  solution    : "Kernel Modules"
  reference   : "CONSULTAR BASELINE HITSS"
  see_also    : "Perfil: Light"
  cmd    : "MOD=cramfs; lsmod | grep \"^$MOD\" || modprobe --showconfig | grep -P \"^\\s*(install|blacklist)\\s+$MOD\\b\" || modinfo -F name \"$MOD\" 2>/dev/null"
  expect : "(?m)^\\s*(blacklist\\s+cramfs|install\\s+cramfs\\s+/bin/true)\\b"
</custom_item>

