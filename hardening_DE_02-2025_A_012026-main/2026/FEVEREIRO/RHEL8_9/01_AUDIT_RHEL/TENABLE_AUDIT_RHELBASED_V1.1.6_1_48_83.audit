    <custom_item>
      type        : CMD_EXEC
      description : "Verificação de existência do log de auditoria HITSS"
      info        : "Detecta se o host já foi auditado anteriormente"
      solution    : "Criar o log em /var/log/hitss-hardening.log na primeira execução"
      reference   : "TENABLE_AUDIT_RHELBASED_V1.1.6"
      see_also    : "/var/log/hitss-hardening.log"
      cmd         : "[ -f /var/log/hitss-hardening.log ] && echo \"PASS\" || echo \"FAIL - host nunca auditado\" "
      expect      : "(?i)^\s*pass\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "Registro de execução do pacote de auditoria HITSS via Tenable"
      info        : "Escreve log do scan"
      solution    : "Não há"
      reference   : "TENABLE_AUDIT_RHELBASED_V1.1.6"
      see_also    : "Não há"
      cmd         : "echo \\\"$(date -Iseconds) - AUDIT - v1.1.6 - VIA TENABLE - host: $(hostname)\\\" >> /var/log/hitss-hardening.log && echo \"PASS\" "
      expect      : "(?i)^\s*pass\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "Leitura do último registro de auditoria HITSS"
      info        : "Última execução registrada no log de hardening"
      solution    : "Verificar se o log está sendo atualizado corretamente"
      reference   : "TENABLE_AUDIT_RHELBASED_V1.1.6"
      see_also    : "/var/log/hitss-hardening.log"
      cmd         : "tail -n 1 /var/log/hitss-hardening.log"
      expect      : ".*"
    </custom_item>

#################################################################
#################################################################
#################################################################

</check_type>
