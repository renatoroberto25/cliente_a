  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "199"
  info        : "Média"
  solution    : "Home"
  reference   : "Verificar usuários sem diretório home."
  see_also    : "Light"
  cmd         : "(awk -F: '($3>=1000 && $7!=\"/sbin/nologin\" && $7!=\"/bin/false\"){print $1\":\"$6}' /etc/passwd | while IFS=: read u d; do [ -d \"$d\" ] || echo \"$u\"; done | grep -q . && echo \"FAIL\" || echo \"PASS\")"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "200"
  info        : "Alta"
  solution    : "Home"
  reference   : "Ajustar ownership dos diretórios home."
  see_also    : "Light"
  cmd         : "(awk -F: '($3>=1000 && $7!=\"/sbin/nologin\" && $7!=\"/bin/false\"){print $1\":\"$6}' /etc/passwd | while IFS=: read u d; do [ -d \"$d\" ] && [ \"$(stat -c %U \"$d\")\" = \"$u\" ] || echo \"$u\"; done | grep -q . && echo \"FAIL\" || echo \"PASS\")"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "201"
  info        : "Alta"
  solution    : "Home"
  reference   : "Ajustar permissões de home para 750."
  see_also    : "Light"
  cmd         : "(find /home -mindepth 1 -maxdepth 1 -type d -perm /027 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\")"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
