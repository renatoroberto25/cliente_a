<check_type:"Unix">
<custom_item>
  type        : CMD_EXEC
  description : "1"
  info        : "Alta"
  solution    : "Kernel"
  reference   : "Bloquear módulo cramfs persistentemente via modprobe.d e remover se carregado."
  see_also    : "Light"
  cmd         : "((modinfo cramfs &>/dev/null && modprobe --showconfig | grep -Pq '\\b(install|blacklist)\\h+cramfs\\b' && ! lsmod | grep -q cramfs) || (! modinfo cramfs &>/dev/null)) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

