 cmd         : "(chrony_active=$(systemctl is-active chronyd 2>/dev/null | grep -c '^active$'); ntpd_active=$(systemctl is-active ntpd 2>/dev/null | grep -c '^active$'); if [ \"$chrony_active\" -eq 1 ] && [ \"$ntpd_active\" -eq 0 ]; then echo \"PASS\"; elif [ \"$chrony_active\" -eq 0 ] && [ \"$ntpd_active\" -eq 1 ]; then echo \"PASS\"; else echo \"FAIL\"; fi)"
 expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

