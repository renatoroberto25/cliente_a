187	MÉDIA/ALTA	Permissões exatas esperadas
<custom_item>
  type        : CMD_EXEC
  description : "187"
  info        : "Alta"
  solution    : "Permissões"
  reference   : "Ajustar permissões de /etc/shadow."
  see_also    : "Light"
  cmd         : "( grep -REq '^\\s*umask\\s+0[2-7][2-7]\\b' /etc/profile /etc/bashrc 2>/dev/null ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

echo -e "\n187 Ajustar permissões de /etc/shadow."
( stat -c '%a %U %G' /etc/shadow 2>/dev/null | grep -Eq '^(000|400|600|640) root root$' ) && echo "PASS" || echo "FAIL"



58	MÉDIA	Critério de serviço ativo

<custom_item>
  type        : CMD_EXEC
  description : "58"
  info        : "Alta"
  solution    : "Sistema"
  reference   : "Habilitar serviço de sincronização de tempo aprovado."
  see_also    : "Light"
  cmd         : "( systemctl is-enabled chronyd 2>/dev/null | grep -qx enabled && systemctl is-active chronyd 2>/dev/null | grep -qx active ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>


echo -e "\n58 Habilitar serviço de sincronização de tempo aprovado."
( rpm -q chrony >/dev/null 2>&1 && systemctl is-enabled chronyd 2>/dev/null | grep -qx enabled ) && echo "PASS" || echo "FAIL"
