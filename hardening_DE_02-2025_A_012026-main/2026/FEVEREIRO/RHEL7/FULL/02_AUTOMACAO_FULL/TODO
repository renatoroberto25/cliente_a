[8] overlayfs disabled
( ( ! modinfo overlay &>/dev/null ) || ( modprobe --showconfig 2>/dev/null | grep -Eq "^[[:space:]]*(install|blacklist)[[:space:]]+overlay([[:space:]]|$)" && ! lsmod 2>/dev/null | grep -Eq "^[[:space:]]*overlay[[:space:]]" ) ) && echo \"PASS\" || echo \"FAIL\"

[15] ptrace_scope restricted
( ( sysctl -n kernel.yama.ptrace_scope 2>/dev/null | grep -Eq "^[1-3]$" ) || ( ! sysctl -n kernel.yama.ptrace_scope &>/dev/null ) ) && echo \"PASS\" || echo \"FAIL\"

[18] IOMMU enabled (boot)
( grep -Eq "(^|[[:space:]])iommu=on([[:space:]]|$)" /proc/cmdline 2>/dev/null ) && echo \"PASS\" || echo \"FAIL\"

[19] perf_event_paranoid restricted
( sysctl -n kernel.perf_event_paranoid 2>/dev/null | grep -Eq "^[2-3]$" ) && echo \"PASS\" || echo \"FAIL\"

[21] user namespaces disabled (RHEL7)
(( sysctl -n user.max_user_namespaces 2>/dev/null | grep -q "^0$" ) || ( ! sysctl -n user.max_user_namespaces &>/dev/null ) ) && echo \"PASS\" || echo \"FAIL\"

[54] unconfined_service_t minimized
( ( getenforce 2>/dev/null | grep -Eq "Enforcing|Permissive" && ! ps -eZ 2>/dev/null | grep -q "unconfined_service_t" ) || ( getenforce 2>/dev/null | grep -Eq "Disabled" ) ) && echo \"PASS\" || echo \"FAIL\"

[55] no unconfined_t processes
( ( getenforce 2>/dev/null | grep -Eq "Enforcing|Permissive" && ! ps -eZ 2>/dev/null | grep -q "unconfined_t" ) || ( getenforce 2>/dev/null | grep -Eq "Disabled" ) ) && echo \"PASS\" || echo \"FAIL\"

[59] chrony configured
( ! rpm -q chrony &>/dev/null || ( systemctl is-active --quiet chronyd 2>/dev/null && grep -Eq "^[[:space:]]*server[[:space:]]+" /etc/chrony.conf 2>/dev/null ) ) && echo \"PASS\" || echo \"FAIL\"

