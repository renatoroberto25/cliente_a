[108] TLS >= 1.2
( ( grep -Eq "(TLSv1\.2|TLSv1\.3)" /etc/crypto-policies/config 2>/dev/null ) || ( grep -Eq "(MinProtocol.*TLSv1\.2|ssl_protocol.*TLSv1\.2)" /etc/httpd/conf.d/* 2>/dev/null ) || ( grep -Eq "ssl_protocol.*TLSv1\.2" /etc/nginx/* 2>/dev/null ) ) && echo \"PASS\" || echo \"FAIL\"

