<custom_item>
  type        : CMD_EXEC
  description : "197"
  info        : "Verifique se maxrepeat está configurado"
  solution    : "Configurar 'maxrepeat=<n>' em pwquality"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q 'maxrepeat\\s*=' /etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "198"
  info        : "Verifique se maxsequence está configurado"
  solution    : "Configurar 'maxsequence=<n>' em pwquality"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q 'maxsequence\\s*=' /etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
