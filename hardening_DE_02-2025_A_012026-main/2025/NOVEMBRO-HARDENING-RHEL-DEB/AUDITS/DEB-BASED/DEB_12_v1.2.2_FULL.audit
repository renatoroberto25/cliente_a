##################################################### 93 - 106

    <custom_item>
      type        : CMD_EXEC
      description : "93"
      info        : "Verifique se apenas um daemon de sincronização de tempo está em uso"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( (systemctl is-active --quiet systemd-timesyncd.service && ! systemctl is-active --quiet chrony.service) || (! systemctl is-active --quiet systemd-timesyncd.service && systemctl is-active --quiet chrony.service) ) && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "94"
      info        : "Verifique se o systemd-timesyncd está configurado com servidor autorizado"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "if systemctl is-active --quiet systemd-timesyncd.service; then (grep -Eq '^[[:space:]]*(NTP|FallbackNTP)[[:space:]]*=[[:space:]]*[^[:space:]]' /etc/systemd/timesyncd.conf /etc/systemd/timesyncd.conf.d/* 2>/dev/null && echo \'PASS\' || echo \'FAIL\'); elif systemctl is-active --quiet chrony.service; then echo \'PASS\'; else echo \'FAIL\'; fi"
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "95"
      info        : "Verifique se o systemd-timesyncd está habilitado e em execução"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "if systemctl is-active --quiet systemd-timesyncd.service; then (systemctl is-enabled --quiet systemd-timesyncd.service 2>/dev/null && systemctl is-active --quiet systemd-timesyncd.service 2>/dev/null && echo \'PASS\' || echo \'FAIL\'); elif systemctl is-active --quiet chrony.service; then echo \'PASS\'; else echo \'FAIL\'; fi"
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "96"
      info        : "Verifique se o chrony está configurado com servidor autorizado"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "grep -Eq '^[[:space:]]*(server|pool)[[:space:]]+' /etc/chrony/chrony.conf 2>/dev/null && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "97"
      info        : "Verifique se o chronyd está rodando como usuário _chrony"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : " pgrep -u _chrony -x chronyd >/dev/null 2>&1 && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
