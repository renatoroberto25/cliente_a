</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "199"
  info        : "Verifique se dictcheck está configurado"
  solution    : "Configurar 'dictcheck=1' (ou valor corporativo) em pwquality e garantir dicionário instalado"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q 'dictcheck\\s*=' /etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "200"
  info        : "Verifique se enforce_for_root está habilitado (pwquality)"
  solution    : "Adicionar 'enforce_for_root' em pwquality"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q '(^|[[:space:]])enforce_for_root(\\b|[[:space:]])' /etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "201"
  info        : "Verifique se enforce_for_root está habilitado explicitamente para root (pwquality)"
  solution    : "Adicionar 'enforce_for_root' em pwquality (global)"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q '(^|[[:space:]])enforce_for_root(\\b|[[:space:]])' /etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "202"
  info        : "Verifique se remember está configurado (pwhistory)"
  solution    : "Configurar 'remember=<n>' em /etc/security/pwhistory.conf"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q 'remember\\s*=' /etc/security/pwhistory.conf 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "203"
  info        : "Verifique se enforce_for_root está habilitado (pwhistory)"
  solution    : "Adicionar 'enforce_for_root' em /etc/security/pwhistory.conf"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q '(^|[[:space:]])enforce_for_root(\\b|[[:space:]])' /etc/security/pwhistory.conf 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "204"
  info        : "Verifique se use_authtok está habilitado (pwhistory na pilha PAM)"
  solution    : "Garantir 'use_authtok' na linha correspondente em /etc/pam.d/common-password"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q 'use_authtok' /etc/pam.d/common-password 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "205"
  info        : "Verifique se pam_unix não usa nullok (FAIL se presente)"
  solution    : "Remover 'nullok' de linhas com pam_unix.so em /etc/pam.d/common-password"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q 'pam_unix\\.so.*nullok' /etc/pam.d/common-password 2>/dev/null && echo \'FAIL\') || echo \'PASS\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "206"
  info        : "Verifique se pam_unix não usa remember=n (FAIL se presente)"
  solution    : "Remover 'remember=' de linhas com pam_unix.so (usar pwhistory para histórico)"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q 'pam_unix\\.so.*remember=' /etc/pam.d/common-password 2>/dev/null && echo \'FAIL\') || echo \'PASS\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "207"
  info        : "Verifique se pam_unix usa hashing forte (sha512 ou yescrypt)"
  solution    : "Em /etc/pam.d/common-password, garantir pam_unix.so com 'sha512' ou 'yescrypt'"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -Eq 'pam_unix\\.so.*(sha512|yescrypt)' /etc/pam.d/common-password 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "208"
  info        : "Verifique se pam_unix inclui use_authtok"
  solution    : "Adicionar 'use_authtok' à linha pam_unix.so em /etc/pam.d/common-password"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( egrep -q 'pam_unix\\.so.*use_authtok' /etc/pam.d/common-password 2>/dev/null && echo \'PASS\' ) || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>
#209 v3
    <custom_item>
      type        : CMD_EXEC
      description : "209"
      info        : "Verifique se PASS_MAX_DAYS está configurado (≤ 365)"
      solution    : "Defina PASS_MAX_DAYS <= 365 em /etc/login.defs e com chage"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Pi '^\\s*PASS_MAX_DAYS\\s+[0-9]+' /etc/login.defs | awk '{if ($2<=365 && $2>0) exit 0; else exit 1}') && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "210"
      info        : "Verifique se PASS_MIN_DAYS está configurado (≥ 1)"
      solution    : "Defina PASS_MIN_DAYS >= 1 em /etc/login.defs"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^\\s*PASS_MIN_DAYS\\s+[0-9]+' /etc/login.defs | awk '{exit !($2>=1)}') && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "211"
      info        : "Verifique se PASS_WARN_AGE está configurado (≥ 7)"
      solution    : "Defina PASS_WARN_AGE >= 7 em /etc/login.defs"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^\\s*PASS_WARN_AGE\\s+[0-9]+' /etc/login.defs | awk '{exit !($2>=7)}') && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "212"
      info        : "Verifique se algoritmo de hashing forte está configurado (sha512/yescrypt)"
      solution    : "Defina ENCRYPT_METHOD em /etc/login.defs ou pam_unix.so (sha512 ou yescrypt)"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi 'ENCRYPT_METHOD\\s+(SHA512|YESCRYPT)' /etc/login.defs /etc/pam.d/common-password 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "213"
      info        : "Verifique se inatividade (INACTIVE) está configurada (≤ 45)"
      solution    : "Defina INACTIVE <= 45 em useradd e com chage"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(useradd -D | grep -q 'INACTIVE=[0-9]\\+' && [ $(useradd -D | grep INACTIVE | cut -d= -f2) -le 45 ] && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "214"
      info        : "Verifique se todas as senhas foram alteradas no passado"
      solution    : "Use chage para revisar contas"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(awk -F: '$2 ~ /\\$/ && $3 < 1 {exit 1}' /etc/shadow && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "215"
      info        : "Verifique se apenas root possui UID 0"
      solution    : "Reconfigure contas indevidas com UID 0"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(awk -F: '($3 == 0 && $1 != \"root\") {exit 1}' /etc/passwd && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "216"
      info        : "Verifique se apenas root possui GID 0 (exceto sync,shutdown,halt,operator)"
      solution    : "Corrija grupos indevidos com GID 0"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(awk -F: '($4 == 0 && $1 !~ /^(root|sync|shutdown|halt|operator)$/) {exit 1}' /etc/passwd && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "217"
      info        : "Verifique se apenas o grupo root possui GID 0"
      solution    : "Corrija /etc/group para que só root tenha GID 0"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(awk -F: '($3 == 0 && $1 != \"root\") {exit 1}' /etc/group && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "218"
      info        : "Verifique se a conta root possui senha definida ou está bloqueada"
      solution    : "Defina senha ou bloqueie conta root"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(awk -F: '($1==\"root\" && $2 ~ /^[!*]/) {f=1} ($1==\"root\" && $2 ~ /^\\$/) {f=1} END{exit !(f)}' /etc/shadow && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "219"
      info        : "Verifique a integridade do PATH do root"
      solution    : "Remova entradas inseguras (., ::, ou dirs inexistentes)"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(echo $PATH | grep -Eq '(^:|::|:.$)' && echo \'FAIL\'|| echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

#Testar
    <custom_item>
      type        : CMD_EXEC
      description : "220"
      info        : "Verifique se umask do root está configurada (027 ou 077)"
      solution    : "Configure umask adequada no .bashrc/.profile"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Pi '^[[:space:]]*umask[[:space:]]+(027|077)\\b' /root/.bashrc /root/.bash_profile 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "221"
      info        : "Verifique se contas de sistema não possuem shell de login"
      solution    : "Ajuste /etc/passwd para nologin"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(awk -F: '($3<1000 && $7 !~ /(nologin|false)$/ && $1!~ /^(root|sync|shutdown|halt)$/) {exit 1}' /etc/passwd && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

#Testar
    <custom_item>
      type        : CMD_EXEC
      description : "222"
      info        : "Verifique se contas sem shell válido estão bloqueadas"
      solution    : "Bloqueie contas sem shell válido"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(awk -F: '($7~/nologin$|false$/ && $1!=\"root\"){print $1}' /etc/passwd | while read -r user; do status=$(passwd -S \"$user\" 2>/dev/null | awk '{print $2}'); [ \"$status\" = \"L\" ] || exit 1; done && echo \'PASS\' ||     echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "223"
      info        : "Verifique se /etc/shells não contém /nologin"
      solution    : "Remova /nologin de /etc/shells"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(! grep -q '/nologin' /etc/shells && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "224"
      info        : "Verifique se TMOUT <= 900 está configurado como readonly e exportado"
      solution    : "Defina TMOUT=900 em /etc/profile.d/*.sh e exporte"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^\\s*TMOUT=([0-9]{1,3}|900)\\b' /etc/profile /etc/profile.d/*.sh 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "225"
      info        : "Verifique se umask padrão está configurada (027)"
      solution    : "Configure umask padrão em /etc/login.defs ou /etc/profile"
      reference   : "HITSS Debian 12 - 5.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^\\s*UMASK\\s+027\\b' /etc/login.defs /etc/profile /etc/profile.d/*.sh 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "226"
      info        : "Verifique se o serviço journald está ativo"
      solution    : "Ative o journald se necessário"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(systemctl is-active --quiet systemd-journald.service && systemctl is-enabled systemd-journald.service 2>/dev/null | grep -q 'static' && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "227"
      info        : "Verifique se o acesso aos arquivos do journald está configurado"
      solution    : "Ajuste permissões conforme política (≤0640, root:systemd-journal)"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(stat -Lc '%a' /var/log/journal/*/*.journal 2>/dev/null | awk '{if ($1+0 > 640) exit 1} END{exit 0}' && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

#228
    <custom_item>
      type        : CMD_EXEC
      description : "228"
      info        : "Verifique se a rotação de logs do journald está configurada"
      solution    : "Configure SystemMaxUse, KeepFree, etc."
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^[[:space:]]*(SystemMaxUse|SystemKeepFree|RuntimeMaxUse|RuntimeKeepFree|MaxFileSec)=' /etc/systemd/journald.conf /etc/systemd/journald.conf.d/*.conf 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>


    <custom_item>
      type        : CMD_EXEC
      description : "229"
      info        : "Verifique se apenas um sistema de logging está em uso"
      solution    : "Mantenha apenas journald ou rsyslog"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( (systemctl is-active --quiet rsyslog && ! systemctl is-active --quiet systemd-journald) || (! systemctl is-active --quiet rsyslog && systemctl is-active --quiet systemd-journald) ) && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "230"
      info        : "Verifique se o pacote systemd-journal-remote está instalado"
      solution    : "Instale o pacote se necessário"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(dpkg-query -W -f='${Status}\n' systemd-journal-remote 2>/dev/null | grep -q 'install ok installed' && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "231"
      info        : "Verifique se a autenticação do journal-upload está configurada"
      solution    : "Configure URL/ServerKey/Certs"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^[[:space:]]*(URL|ServerKeyFile|ServerCertificateFile|TrustedCertificateFile)=' /etc/systemd/journal-upload.conf /etc/systemd/journal-upload.conf.d/*.conf 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "232"
      info        : "Verifique se o serviço systemd-journal-upload está habilitado e ativo"
      solution    : "Ative o serviço se necessário"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(systemctl is-enabled --quiet systemd-journal-upload.service 2>/dev/null && systemctl is-active --quiet systemd-journal-upload.service 2>/dev/null && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "233"
      info        : "Verifique se o systemd-journal-remote não está em uso"
      solution    : "Desabilite systemd-journal-remote"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(! systemctl is-enabled --quiet systemd-journal-remote.socket 2>/dev/null && ! systemctl is-enabled --quiet systemd-journal-remote.service 2>/dev/null && ! systemctl is-active --quiet systemd-journal-remote.socket 2>/dev/null && ! systemctl is-active --quiet systemd-journal-remote.service 2>/dev/null && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "234"
      info        : "Verifique se ForwardToSyslog está desabilitado"
      solution    : "Configure ForwardToSyslog=no"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^[[:space:]]*ForwardToSyslog=no\\b' /etc/systemd/journald.conf /etc/systemd/journald.conf.d/*.conf 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "235"
      info        : "Verifique se Compress está configurado"
      solution    : "Configure Compress=yes"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^[[:space:]]*Compress=yes\\b' /etc/systemd/journald.conf /etc/systemd/journald.conf.d/*.conf 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "236"
      info        : "Verifique se Storage está configurado como persistente"
      solution    : "Configure Storage=persistent"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^[[:space:]]*Storage=persistent\\b' /etc/systemd/journald.conf /etc/systemd/journald.conf.d/*.conf 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "237"
      info        : "Verifique se o rsyslog está instalado"
      solution    : "Instale rsyslog se necessário"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(dpkg-query -W -f='${Status}' rsyslog 2>/dev/null | grep -q '^install ok installed$' && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "238"
      info        : "Verifique se o serviço rsyslog está habilitado e ativo"
      solution    : "Ative o serviço rsyslog"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(( systemctl list-unit-files 2>/dev/null | grep -q '^rsyslog\\.service' ) && systemctl is-enabled --quiet rsyslog 2>/dev/null && systemctl is-active --quiet rsyslog 2>/dev/null && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "239"
      info        : "Verifique se journald está configurado para enviar logs ao rsyslog"
      solution    : "Configure ForwardToSyslog=yes"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^[[:space:]]*ForwardToSyslog=yes\\b' /etc/systemd/journald.conf /etc/systemd/journald.conf.d/*.conf 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

#Revisar
    <custom_item>
      type        : CMD_EXEC
      description : "240"
      info        : "Verifique se o modo de criação de arquivos rsyslog está configurado (0640)"
      solution    : "Configure $FileCreateMode 0640"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(grep -Psi '^[[:space:]]*\\$FileCreateMode[[:space:]]+0(640|60[0-3]|[0-5][0-9]{2})\\b' /etc/rsyslog.conf /etc/rsyslog.d/*.conf 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

# 241 - 244 não aplicável
    <custom_item>
      type        : CMD_EXEC
      description : "245"
      info        : "Verifique se permissões de arquivos de log estão configuradas (≤0640)"
      solution    : "Ajuste chmod/chown em /var/log"
      reference   : "HITSS Debian 12 - 4.2.x"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "(find /var/log -type f -exec stat -Lc '%a' {} \; 2>/dev/null | awk '{if(\$1>640) exit 1} END{exit 0}' && echo \'PASS\' ||echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

# 246 - 310
    <custom_item>
      type        : CMD_EXEC
      description : "246"
      info        : "Ensure auditd packages are installed"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "dpkg-query -W -f='${Status}\n' auditd 2>/dev/null | grep -qx 'install ok installed' && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^\s*pass\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "247"
      info        : "Ensure auditd service is enabled and active"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "systemctl is-enabled auditd 2>/dev/null | grep -qx enabled && systemctl is-active auditd 2>/dev/null | grep -qx active && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^\s*pass\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "248"
      info        : "Ensure auditing for processes that start prior to auditd is enabled"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "{ grep -REq '(^|[[:space:]])audit=1([[:space:]]|$)' /etc/default/grub /etc/default/grub.d 2>/dev/null && grep -Eq '(^|[[:space:]])audit=1([[:space:]]|$)' /boot/grub/grub.cfg; } && echo \'PASS\' || echo    \'FAIL\' "
      expect      : "(?i)^\s*pass\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "249"
      info        : "Verifique se o parâmetro audit_backlog_limit é ≥ 8192 nos arquivos de configuração do GRUB."
      solution    : "Edite /etc/default/grub ou arquivos em /etc/default/grub.d/ e adicione audit_backlog_limit=8192 ao parâmetro GRUB_CMDLINE_LINUX. Depois regenere com grub2-mkconfig."
      reference   : "BASELINE HITSS"
      cmd         : "(grep -Eo 'audit_backlog_limit=[0-9]+' /boot/grub*/grub.cfg /etc/default/grub /etc/default/grub.d/*.cfg 2>/dev/null | tail -n1 | awk -F= '{if(\$2>=8192) exit 0; else    exit 1}') && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>
    
    <custom_item>
      type        : CMD_EXEC
      description : "250"
      info        : "Verifique se o diretório de logs do audit (/var/log/audit) é 0750 ou mais restritivo"
      solution    : "Execute: chmod 0750 /var/log/audit && chown root:root /var/log/audit"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(stat -Lc '%a' /var/log/audit 2>/dev/null | awk '{exit !($1<=750)}') && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "251"
      info        : "Verifique se os arquivos de log do audit são 0640 ou mais restritivos"
      solution    : "Execute: chmod 0640 /var/log/audit/audit.log"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(find /var/log/audit -type f -exec stat -Lc '%a' {} \\; 2>/dev/null | awk '{if(\$1>640) exit 1} END{exit 0}' && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "252"
      info        : "Verifique se somente usuários autorizados são proprietários dos arquivos de log do audit"
      solution    : "O proprietário deve ser root"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(find /var/log/audit -type f -exec stat -Lc '%U' {} \\; 2>/dev/null | grep -Ev '^root\$' | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "253"
      info        : "Verifique se apenas grupos autorizados possuem os arquivos de log do audit"
      solution    : "O grupo deve ser root"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(find /var/log/audit -type f -exec stat -Lc '%G' {} \\; 2>/dev/null | grep -Ev '^root\$' | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "254"
      info        : "Verifique se os arquivos de configuração do auditd possuem permissões 640 ou mais restritivas"
      solution    : "Aplique chmod 640 /etc/audit/auditd.conf /etc/audit/rules.d/*"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(find /etc/audit -type f -exec stat -Lc '%a' {} \\; 2>/dev/null | awk '{if(\$1>640) exit 1} END{exit 0}' && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "255"
      info        : "Verifique se os arquivos de configuração do audit são de propriedade root"
      solution    : "Execute: chown root:root /etc/audit/auditd.conf /etc/audit/rules.d/*"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(find /etc/audit -type f -exec stat -Lc '%U %G' {} \\; 2>/dev/null | awk '{if(\$1!=\"root\" || \$2!=\"root\") exit 1} END{exit 0}' && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "256"
      info        : "Verifique se as ferramentas de auditoria possuem permissões ≤755 e são de root:root"
      solution    : "Aplique chmod 755 e chown root:root em /sbin/auditctl, /sbin/aureport, /sbin/ausearch"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(for f in /sbin/auditctl /sbin/aureport /sbin/ausearch; do [ -x \"$f\" ] || continue; st=$(stat -Lc '%a %U %G' \"$f\"); perm=$(echo \"$st\"|awk '{print \$1}'); usr=$(echo \"$st\"|awk '{print \$2}'); grp=$(echo \"$st\"|awk '{print \$3}'); [ \$perm -le 755 ] && [ \$usr = root ] && [ \$grp = root ] || exit 1; done && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "257"
      info        : "Verifique se o AIDE está instalado"
      solution    : "Instale o pacote aide: dnf install -y aide"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(rpm -q aide &>/dev/null && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "258"
      info        : "Verifique se a integridade do sistema é verificada periodicamente"
      solution    : "Agende o AIDE em /etc/cron.daily/"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "([ -f /etc/cron.daily/aide ] && grep -q '/usr/sbin/aide' /etc/cron.daily/aide 2>/dev/null && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "259"
      info        : "Verifique se mecanismos criptográficos protegem ferramentas do audit"
      solution    : "Instale o pacote aide e configure sha512 em /etc/aide.conf"
      reference   : "HITSS - RHEL/OL 8 - 4.1.x"
      cmd         : "(grep -Psi '^\\s*sha512\\b' /etc/aide.conf 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "260"
      info        : "Verifique se as permissões de /etc/passwd são 644 root:root"
      solution    : "chmod 644 /etc/passwd && chown root:root /etc/passwd"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "([ \"$(stat -Lc '%a %U %G' /etc/passwd 2>/dev/null)\" = '644 root root' ] && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "261"
      info        : "Verifique se as permissões de /etc/shadow são 0000 root:root"
      solution    : "chmod 0000 /etc/shadow && chown root:root /etc/shadow"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "([ \"$(stat -Lc '%a %U %G' /etc/shadow 2>/dev/null)\" = '0000 root root' ] && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "262"
      info        : "Verifique se não há arquivos sem dono ou grupo"
      solution    : "find / -xdev \\( -nouser -o -nogroup \\)"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(find / -xdev \\( -nouser -o -nogroup \\) 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "263"
      info        : "Verifique se não há arquivos ou diretórios world-writable"
      solution    : "find / -xdev -type f -perm -0002"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(df --local -P | awk 'NR!=1 {print $6}' | xargs -I '{}' find '{}' -xdev -type f -perm -0002 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "264"
      info        : "Verifique se não há UIDs duplicados"
      solution    : "awk -F: '{print $3}' /etc/passwd | sort -n | uniq -d"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '{print $3}' /etc/passwd | sort -n | uniq -d | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "265"
      info        : "Verifique se não há GIDs duplicados"
      solution    : "awk -F: '{print $3}' /etc/group | sort -n | uniq -d"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '{print $3}' /etc/group | sort -n | uniq -d | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "266"
      info        : "Verifique se não há nomes de usuários duplicados"
      solution    : "awk -F: '{print $1}' /etc/passwd | sort | uniq -d"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '{print $1}' /etc/passwd | sort | uniq -d | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "267"
      info        : "Verifique se não há grupos duplicados"
      solution    : "awk -F: '{print $1}' /etc/group | sort | uniq -d"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '{print $1}' /etc/group | sort | uniq -d | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "268"
      info        : "Verifique se o root é o único UID 0"
      solution    : "awk -F: '($3 == 0) {print $1}' /etc/passwd"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '($3 == 0 && $1 != \"root\") {exit 1}' /etc/passwd && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "269"
      info        : "Verifique se as permissões de /etc/shells são 644 root:root"
      solution    : "chmod 644 /etc/shells && chown root:root /etc/shells"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "([ \"$(stat -Lc '%a %U %G' /etc/shells 2>/dev/null)\" = '644 root root' ] && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "270"
      info        : "Verifique se não há arquivos ou diretórios sem proprietário ou grupo"
      solution    : "find / -xdev \\( -nouser -o -nogroup \\)"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(find / -xdev \\( -nouser -o -nogroup \\) 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "271"
      info        : "Verifique se não há arquivos SUID/SGID indevidos"
      solution    : "find / -xdev -type f \\( -perm -4000 -o -perm -2000 \\)"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(find / -xdev -type f \\( -perm -4000 -o -perm -2000 \\) 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "272"
      info        : "Verifique se as contas no /etc/passwd usam senhas shadow"
      solution    : "Verifique se o segundo campo é 'x'"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '(\$2 != \"x\") {exit 1}' /etc/passwd && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "273"
      info        : "Verifique se os campos de senha em /etc/shadow não estão vazios"
      solution    : "Edite /etc/shadow e defina hashes válidos para contas locais"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '(\$2 == \"\" || \$2 == \"*\") {exit 1}' /etc/shadow && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "274"
      info        : "Verifique se todos os grupos no /etc/passwd existem no /etc/group"
      solution    : "Garanta que cada GID tenha entrada correspondente no /etc/group"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '{print \$4}' /etc/passwd | grep -v '^$' | while read g; do grep -q \":\$g:\" /etc/group || exit 1; done && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "275"
      info        : "Verifique se não há diretórios home com permissões incorretas (>750)"
      solution    : "find /home -type d -perm /027 -exec chmod 750 {} \\;"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(find /home -mindepth 1 -maxdepth 1 -type d -perm /027 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "276"
      info        : "Verifique se os arquivos ocultos (dotfiles) nos homes não têm permissões indevidas (022)"
      solution    : "find /home -type f -name '.*' -perm /022"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(find /home -type f -name '.*' -perm /022 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "277"
      info        : "Verifique se os diretórios home são de propriedade de seus respectivos usuários"
      solution    : "chown <user>:<user> /home/<user>"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '(\$3 >= 1000 && \$7 !~ /nologin|false/) {print \$1\":\"\$6}' /etc/passwd | while IFS=: read u d; do [ -d \"$d\" ] || continue; owner=$(stat -Lc %U \"$d\" 2>/dev/null); [ \"$owner\" = \"$u\" ] || exit 1; done && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "278"
      info        : "Verifique se o umask padrão global é ≤027"
      solution    : "Ajuste o umask em /etc/profile, /etc/bashrc e /etc/login.defs"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(grep -Psi '^[[:space:]]*umask[[:space:]]+0?(0[0-2][0-7]|02[0-7]|027)\\b' /etc/profile /etc/bashrc /etc/login.defs 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "279"
      info        : "Verifique se /etc/profile define timeout de shell (TMOUT)"
      solution    : "Adicione TMOUT=900 e export TMOUT"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(grep -Psi '^[[:space:]]*TMOUT=[0-9]+' /etc/profile /etc/profile.d/*.sh 2>/dev/null | grep -q . && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "280"
      info        : "Verifique se o root é o único GID 0"
      solution    : "grep ':0:' /etc/group"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '(\$3==0 && \$1!=\"root\") {exit 1}' /etc/group && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "281"
      info        : "Verifique se o PATH do root é seguro"
      solution    : "Remova '.' e verifique diretórios inexistentes"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(echo \"$PATH\" | grep -Eq '(^|:)(\\.|::|:/$|:root)' && echo \'FAIL\' || echo \'PASS\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "282"
      info        : "Verifique se apenas root possui UID 0"
      solution    : "awk -F: '(\$3==0 && \$1!=\"root\") {print \$1}' /etc/passwd"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '(\$3==0 && \$1!=\"root\") {exit 1}' /etc/passwd && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "283"
      info        : "Verifique se contas do sistema possuem shell inválido (/sbin/nologin)"
      solution    : "Configure /sbin/nologin nas contas de sistema"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '(\$3<1000 && \$7!=\"/sbin/nologin\" && \$1!=\"root\") {exit 1}' /etc/passwd && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "284"
      info        : "Verifique se as contas sem login shell estão bloqueadas"
      solution    : "usermod -L <usuario>"
      reference   : "HITSS - RHEL/OL 8 - 7.1.x"
      cmd         : "(awk -F: '(\$7~/nologin|false/) {print \$1}' /etc/passwd | while read u; do passwd -S \"$u\" 2>/dev/null | grep -q 'L' || exit 1; done && echo \'PASS\' || echo \'FAIL\')"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "285"
      info        : "Verifique se o AIDE está instalado"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "dpkg-query -W -f='${Status}\n' aide 2>/dev/null | grep -qx 'install ok installed' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "286"
      info        : "Verifique se o filesystem integrity (AIDE) é checado regularmente"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "systemctl is-enabled --quiet dailyaidecheck.timer 2>/dev/null && systemctl is-active --quiet dailyaidecheck.timer 2>/dev/null && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "287"
      info        : "Verifique se o AIDE protege as ferramentas de auditoria com mecanismos criptográficos"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "command -v aide >/dev/null 2>&1 && grep -Eq '/sbin/(auditctl|auditd|ausearch|aureport|autrace|augenrules).*p\\+i\\+n\\+u\\+g\\+s\\+b\\+acl\\+xattrs\\+sha512' /etc/aide/aide.conf && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "288"
      info        : "Verifique permissões de /etc/passwd"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/passwd ] && stat -Lc '%a %u %g' /etc/passwd | grep -Eq '^6(4[0-4]|[0-3][0-7]) 0 0$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "289"
      info        : "Verifique permissões de /etc/passwd-"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/passwd- ] && stat -Lc '%a %u %g' /etc/passwd- | grep -Eq '^6(4[0-4]|[0-3][0-7]) 0 0$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "290"
      info        : "Verifique permissões de /etc/group"
      solution    : "Ajuste chmod/chown de /etc/group para ≤644 e dono root:root"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/group ] && stat -Lc '%a %u %g' /etc/group | grep -Eq '^6(4[0-4]|[0-3][0-7]) 0 0$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "291"
      info        : "Verifique permissões de /etc/group-"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/group- ] && stat -Lc '%a %u %g' /etc/group- | grep -Eq '^6(4[0-4]|[0-3][0-7]) 0 0$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "292"
      info        : "Verifique permissões de /etc/shadow"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/shadow ] && stat -Lc '%a %u %g' /etc/shadow | grep -Eq '^(64[0]?|60[0]?) 0 (0|42)$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "293"
      info        : "Verifique permissões de /etc/shadow-"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/shadow- ] && stat -Lc '%a %u %g' /etc/shadow- | grep -Eq '^(64[0]?|60[0]?) 0 (0|42)$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "294"
      info        : "Verifique permissões de /etc/gshadow"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/gshadow ] && stat -Lc '%a %u %g' /etc/gshadow | grep -Eq '^(64[0]?|60[0]?) 0 (0|42)$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "295"
      info        : "Verifique permissões de /etc/gshadow-"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/gshadow- ] && stat -Lc '%a %u %g' /etc/gshadow- | grep -Eq '^(64[0]?|60[0]?) 0 (0|42)$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "296"
      info        : "Verifique permissões de /etc/shells"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/shells ] && stat -Lc '%a %u %g' /etc/shells | grep -Eq '^6(4[0-4]|[0-3][0-7]) 0 0$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "297"
      info        : "Verifique permissões de /etc/security/opasswd"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "[ -f /etc/security/opasswd ] && stat -Lc '%a %u %g' /etc/security/opasswd | grep -Eq '^600 0 0$' && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "298"
      info        : "Verifique se não existem arquivos world-writable sem sticky bit"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "find / -xdev \\( -type f -perm -0002 -o -type d -perm -0002 ! -perm -1000 \\) 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "299"
      info        : "Verifique se não existem arquivos sem dono ou grupo"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "find / -xdev \\( -nouser -o -nogroup \\) 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "300"
      info        : "Verifique se existem arquivos SUID/SGID (revisão manual)"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "find / -xdev -type f \\( -perm -4000 -o -perm -2000 \\) 2>/dev/null | grep -q . && echo \'FAIL\' || echo \'PASS\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "301"
      info        : "Verifique se contas usam shadowed passwords"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "awk -F: '($2 != \"x\") {exit 1}' /etc/passwd && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "302"
      info        : "Verifique se não há senhas vazias em /etc/shadow"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "awk -F: '($2 == \"\") {exit 1}' /etc/shadow && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "303"
      info        : "Verifique se todos GIDs do passwd existem no group"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "awk -F: '{print $4}' /etc/passwd | sort -u | while read gid; do getent group \"$gid\" >/dev/null || exit 1; done && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "304"
      info        : "Verifique se o grupo shadow está vazio"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "awk -F: '($1==\"shadow\" && $NF!=\"\") {exit 1}' /etc/group && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "305"
      info        : "Verifique se não existem UIDs duplicados"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "cut -d: -f3 /etc/passwd | sort -n | uniq -d | grep -q . && echo \'FAIL\' || echo \'PASS\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "306"
      info        : "Verifique se não existem GIDs duplicados"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "cut -d: -f3 /etc/group | sort -n | uniq -d | grep -q . && echo \'FAIL\' || echo \'PASS\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

