<check_type:"Unix">

#1.x
    <custom_item>
      type            : CMD_EXEC
      description     : "1"
      info            : "Verifique se o módulo do kernel do CRAMFS está ausente ou bloqueado"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "(modinfo cramfs &>/dev/null && modprobe --showconfig | grep -Pq '\\b(install|blacklist)\\h+cramfs\\b' && ! lsmod | grep -q cramfs) || (! modinfo cramfs &>/dev/null) && echo \'PASS\' || echo \'FAIL\' "
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>
    
    <custom_item>
      type            : CMD_EXEC
      description     : "2"
      info            : "Verifique se o módulo do kernel do Freevxfs está ausente ou bloqueado"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "( (modinfo freevxfs >/dev/null 2>&1 && modprobe --showconfig | grep -Eq '^(install|blacklist)[[:space:]]+freevxfs' && ! lsmod | grep -q freevxfs) || ! modinfo freevxfs >/dev/null 2>&1 ) && echo \'PASS\' || echo \'FAIL\' "
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>
    
