      cmd         : "awk -F: '($7!~/nologin|false/ && $3>=1000 && $1!=\"nobody\"){print $6}' /etc/passwd | while read h; do [ -d \"$h\" ] || continue; find \"$h\" -maxdepth 1 -type f -name '.*' -perm /022 | grep -q . && exit 1; done && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>


