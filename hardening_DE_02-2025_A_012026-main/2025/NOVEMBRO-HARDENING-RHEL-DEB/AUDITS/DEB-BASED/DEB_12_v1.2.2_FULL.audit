      description : "309"
      info        : "Verifique se diretórios home de usuários interativos estão configurados corretamente"
      solution    : "CONSULTAR BASELINE HITSS"
      reference   : "CONSULTAR BASELINE HITSS"
      cmd         : "awk -F: '($7!~/nologin|false/ && $3>=1000 && $1!=\"nobody\"){print $1\":\"$6}' /etc/passwd | while IFS=: read u h; do [ -d \"$h\" ] || continue; stat -Lc '%a %U' \"$h\" | awk -v u=\"$u\" '($1<=750 && $2==u){exit 0} {exit 1}' || exit 1; done && echo \'PASS\' || echo \'FAIL\'"
      expect      : "(?i)^\\s*pass\\s*$"
