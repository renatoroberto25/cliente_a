    <custom_item>
      type        : CMD_EXEC
      description : "83"
      info        : "Verifique se o serviço xinetd não está em uso"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( ! dpkg-query -W -f='${Status}\n' xinetd 2>/dev/null | grep -q 'install ok installed' || ( ! systemctl is-active --quiet xinetd && ! systemctl is-enabled xinetd &>/dev/null ) ) && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "84"
      info        : "Verifique se o servidor gráfico (Xorg) não está em uso"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "pgrep -x Xorg >/dev/null && echo \'FAIL\' || echo \'PASS\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "85"
      info        : "Verifique se o MTA está configurado apenas para localhost"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( ! dpkg-query -W -f='${Status}\n' postfix 2>/dev/null | grep -q 'install ok installed' || grep -Pq '^\\s*inet_interfaces\\s*=\\s*(loopback-only|127\\.0\\.0\\.1)\\b' /etc/postfix/main.cf 2>/dev/null ) && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

