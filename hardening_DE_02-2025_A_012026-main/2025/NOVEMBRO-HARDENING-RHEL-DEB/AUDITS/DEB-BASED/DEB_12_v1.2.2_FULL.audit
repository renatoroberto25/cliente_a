    <custom_item>
    type            : CMD_EXEC
    description     : "37"
    info            : "Verifique se chaves GPG estão configuradas"
    solution        : "SOLUTION"
    reference       : "BASELINE HITSS"
    see_also        : "CONSULTAR BASELINE HITSS"
    cmd             : "(find /etc/apt/trusted.gpg /etc/apt/trusted.gpg.d -type f -name '*.gpg' 2>/dev/null | grep -q .) && echo \'PASS\' || echo \'FAIL\' "
    expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
  </custom_item>

#3.x

    <custom_item>
      type            : CMD_EXEC
      description     : "40"
      info            : "Verifique se o AppArmor está instalado"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "(dpkg -s apparmor 2>/dev/null | grep -q 'Status: install ok installed') && echo \'PASS\' || echo \'FAIL\' "
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>
    
    <custom_item>
      type            : CMD_EXEC
      description     : "41"
      info            : "Verifique se o AppArmor está habilitado no bootloader"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "(grep -qw apparmor=1 /proc/cmdline && grep -qw security=apparmor /proc/cmdline) && echo \'PASS\' || echo \'FAIL\' "
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>
    
    <custom_item>
      type            : CMD_EXEC
      description     : "42"
      info            : "Verifique se os perfis AppArmor estão em modo enforce ou complain"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "(aa-status 2>/dev/null | grep -q 'profiles are in enforce mode') && echo \'PASS\' || echo \'FAIL\' "
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>
    
    <custom_item>
      type            : CMD_EXEC
      description     : "43"
      info            : "Verifique se todos os perfis AppArmor estão em modo enforce"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "(aa-status 2>/dev/null | awk '/profiles are in enforce mode/ {e=$1} /profiles are in complain mode/ {c=$1} END{exit !(e+0>0 && c+0==0)}') && echo \'PASS\' || echo \'FAIL\' "
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

#4.x

    <custom_item>
      type            : CMD_EXEC
      description     : "45"
      info            : "Verifique se o acesso ao arquivo de configuração do bootloader está restrito"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "(stat -Lc '%a %U %G' /boot/grub/grub.cfg 2>/dev/null | grep -Eq '^(400|600) root root$') && echo \'PASS\' || echo \'FAIL\' "
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

#5.x
    <custom_item>
      type            : CMD_EXEC
      description     : "46"
      info            : "Verifique se a randomização do espaço de endereços (ASLR) está habilitada"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "(sysctl kernel.randomize_va_space | grep -q 'kernel.randomize_va_space = 2' && echo \'PASS\' || echo \'FAIL\')"
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>
    
    <custom_item>
      type            : CMD_EXEC
      description     : "47"
      info            : "Verifique se o parâmetro ptrace_scope está restrito"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "(sysctl kernel.yama.ptrace_scope | grep -Eq 'kernel.yama.ptrace_scope = [1-3]' && echo \'PASS\' || echo \'FAIL\')"
      expect          : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

#48

<custom_item>
  type        : CMD_EXEC
  description : "48"
  info        : "Verifique se core dumps estão desabilitados"
  solution    : "Defina * hard core 0 em /etc/security/limits.conf ou limits.d/*.conf e fs.suid_dumpable=0"
  reference   : "HITSS Debian 12 - 3.5.x"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "( cat /etc/security/limits.conf /etc/security/limits.d/*.conf 2>/dev/null | egrep -q '^[[:space:]]*\\*[[:space:]]+hard[[:space:]]+core[[:space:]]+0\\b' && sysctl -n fs.suid_dumpable 2>/dev/null | grep -q '^0$' && echo \'PASS\' || echo \'FAIL\')"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

# 52–54 – File permissions
    <custom_item>
      type            : CMD_EXEC
      description     : "52"
      info            : "Verifique se permissões de /etc/motd estão corretas"
      solution        : "SOLUTION"
      reference       : "BASELINE HITSS"
      see_also        : "CONSULTAR BASELINE HITSS"
      cmd             : "stat -Lc '%a %u %g' /etc/motd 2>/dev/null | grep -Eq '^64[0-4] 0 0$' && echo \'PASS\' || echo \'FAIL\' "
      expect          : "(?i)^[\\s]*\\**pass\\**[\\s]*$"
    </custom_item>

    <custom_item>
      type            : CMD_EXEC
      description     : "53"
      info            : "Verifique se permissões de /etc/issue estão corretas"
      solution        : "SOLUTION"
