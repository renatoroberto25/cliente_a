  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "grep -Eq '^Banner[[:space:]]+/.+' /etc/ssh/sshd_config && echo \'PASS\' || echo \'FAIL\' "
