  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "(find /etc/ssh -type f -name \"ssh_host_*_key.pub\" ! -perm 644 | grep -q .) && echo \'FAIL\'|| echo \'PASS\'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "158"
