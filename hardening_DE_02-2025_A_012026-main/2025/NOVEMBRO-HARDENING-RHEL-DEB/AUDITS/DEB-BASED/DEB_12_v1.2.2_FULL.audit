      cmd         : "stat -Lc '%a %U %G' /etc/cron.monthly 2>/dev/null | grep -Eq '^700 root root$' && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "105"
      info        : "Verifique se as permissões de /etc/cron.d estão configuradas (700 root root)"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "stat -Lc '%a %U %G' /etc/cron.d 2>/dev/null | grep -Eq '^700 root root$' && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "106"
      info        : "Verifique se o crontab é restrito a usuários autorizados (/etc/cron.allow 640 root root|crontab)"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "stat -Lc '%a %U %G' /etc/cron.allow 2>/dev/null | grep -Eq '^640 root (root|crontab)$' && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "107"
      info        : "Verifique se o at está restrito a usuários autorizados (aplica-se apenas se cron NÃO existir e at estiver instalado)"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( systemctl list-unit-files | grep -q '^cron.service' && echo \'PASS\' ) || ( ! command -v at >/dev/null 2>&1 && echo \'PASS\' ) || ( [ -f /etc/at.allow ] && stat -Lc '%a %U %G' /etc/at.allow 2>/dev/null | grep -Eq '^600 root root$' && echo \'PASS\' ) || echo \'FAIL\' "
      expect      : "(?i)^[\\s]*\\**[\\s]*pass:?[\\s]*\\**$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "108"
      info        : "Verifique se o IPv6 está desabilitado (kernel param ou sysctl all/default=1)"
      solution    : "SOLUTION"
      reference   : "BASELINE HITSS"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( ( [ -r /sys/module/ipv6/parameters/disable ] && grep -qx '1' /sys/module/ipv6/parameters/disable && echo \'PASS\' ) || ( [ \"$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null)\" = \"1\" ] && [ \"$(sysctl -n net.ipv6.conf.default.disable_ipv6 2>/dev/null)\" = \"1\" ] && echo \'PASS\' ) ) || echo \'FAIL\' "
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

############### 109 - 124

    <custom_item>
      type        : CMD_EXEC
      description : "109"
      info        : "Verifique se interfaces wireless estão desabilitadas (rfkill / net)"
      solution    : "Desabilite interfaces wireless não utilizadas com rfkill ou removendo módulos"
      reference   : "HITSS Debian 12 - 3.1"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( command -v rfkill >/dev/null 2>&1 && rfkill list all 2>/dev/null | grep -Eiq 'wlan|wifi|bluetooth' && echo \'FAIL\') || ( ip link show | grep -Eiq 'wlan|wl' && echo \'FAIL\'|| echo \'PASS\' ) "
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

################ REVISAR 110-114

    <custom_item>
      type        : CMD_EXEC
      description : "110"
      info        : "Verifique se serviços Bluetooth não estão em uso"
      solution    : "Desabilite ou remova o serviço bluetooth.service"
      reference   : "HITSS Debian 12 - 3.2"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( if systemctl list-unit-files 2>/dev/null | grep -q '^bluetooth.service'; then ( ! systemctl is-active --quiet bluetooth.service && ! systemctl is-enabled --quiet bluetooth.service && echo \'PASS\' || echo \'FAIL\'); else echo \'PASS\'; fi )"
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

    <custom_item>
      type        : CMD_EXEC
      description : "111"
      info        : "Verifique se o módulo do kernel dccp não está disponível"
      solution    : "Blacklist o módulo dccp em /etc/modprobe.d/"
      reference   : "HITSS Debian 12 - 3.3.1"
      see_also    : "CONSULTAR BASELINE HITSS"
      cmd         : "( (modinfo dccp &>/dev/null && modprobe --showconfig | grep -Eq '\\b(install|blacklist)[[:space:]]+dccp\\b' && ! lsmod | grep -q '^dccp\\b') || (! modinfo dccp &>/dev/null) ) && echo \'PASS\' || echo \'FAIL\' "
      expect      : "(?i)^\\s*pass\\s*$"
    </custom_item>

