<custom_item>
  type        : CMD_EXEC
  description : "156"
  info        : "Verifique permissões das chaves privadas SSH"
  solution    : "SOLUTION"
  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "(find /etc/ssh -type f -name \"ssh_host_*_key\" ! -perm 600 | grep -q .) && echo \'FAIL\'|| echo \'PASS\'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "157"
