  reference   : "BASELINE HITSS"
  see_also    : "CONSULTAR BASELINE HITSS"
  cmd         : "grep -Eq '^[[:space:]]*(AllowUsers|AllowGroups|DenyUsers|DenyGroups)[[:space:]]+' /etc/ssh/sshd_config && echo \'PASS\' || echo \'FAIL\' "
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

