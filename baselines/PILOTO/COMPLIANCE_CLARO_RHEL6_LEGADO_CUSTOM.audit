  cmd         : "( ! awk -F: '$3>=500 && $1!=\"nfsnobody\" && $7!~/(nologin|false)$/ {print $6}' /etc/passwd | while read h; do for f in .forward .netrc .rhosts; do [ -e \"$h/$f\" ] && echo \"$h/$f\"; done; done | grep -q . ) && echo PASS || echo FAIL"
