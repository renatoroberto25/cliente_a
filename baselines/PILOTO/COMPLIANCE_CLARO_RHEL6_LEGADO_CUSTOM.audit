  reference   : "03_Hardening_2026_RHEL_LEGADO.xlsx | ID 125 | Senhas e Contas | Perfil Light | RHEL6 LEGADO"
  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( [ \"$(awk -F: '$3==0{n++} END{print n+0}' /etc/group)\" = 1 ] && grep -q '^root:x:0:' /etc/group ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-126 | Contas sistema bloqueadas | Criticidade: Alta | RHEL6 LEGADO"
  info        : "Verificar shells de contas de sistema. Bloquear contas de sistema sem necessidade de login interativo."
  solution    : "Bloquear contas de sistema sem necessidade de login interativo."
  reference   : "03_Hardening_2026_RHEL_LEGADO.xlsx | ID 126 | Senhas e Contas | Perfil Light | RHEL6 LEGADO"
  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( ! awk -F: '$3<500 && $1!~/^(root|sync|shutdown|halt)$/ && $7!~/(nologin|false)$/ {print}' /etc/passwd | grep -q . ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-127 | Shells válidos | Criticidade: Baixa | RHEL6 LEGADO"
  info        : "Verificar conteúdo de /etc/shells. Manter /etc/shells consistente."
  solution    : "Manter /etc/shells consistente."
