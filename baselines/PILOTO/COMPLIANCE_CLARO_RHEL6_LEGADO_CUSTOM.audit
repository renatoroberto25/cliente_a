  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( [ -s /etc/shells ] && ! grep -Ev '^$|^/(bin|sbin|usr/bin)/(ba|c|k|z)?sh$|^/bin/(false|nologin)$|^/sbin/nologin$' /etc/shells | grep -q . ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-128 | PATH root seguro | Criticidade: Alta | RHEL6 LEGADO"
  info        : "Verificar PATH do root. Remover diretórios inseguros do PATH do root."
  solution    : "Remover diretórios inseguros do PATH do root."
