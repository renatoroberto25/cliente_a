  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( ! awk -F: '$3>=500 && $1!=\"nfsnobody\" && $7!~/(nologin|false)$/ {print $1, $6}' /etc/passwd | while read u h; do [ -d \"$h\" ] || echo \"$u\"; done | grep -q . ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-174 | Ownership home | Criticidade: Alta | RHEL6 LEGADO"
