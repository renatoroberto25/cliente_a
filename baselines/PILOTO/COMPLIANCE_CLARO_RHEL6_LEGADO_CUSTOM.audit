  cmd         : "( . /etc/os-release 2>/dev/null || :; rel=$(cat /etc/redhat-release 2>/dev/null); echo \"$rel $VERSION_ID\" | grep -Eiq '(Red Hat Enterprise Linux|CentOS|Oracle Linux|Scientific Linux).*(release[[:space:]]+6|6\\.)|VERSION_ID=.?6' ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
