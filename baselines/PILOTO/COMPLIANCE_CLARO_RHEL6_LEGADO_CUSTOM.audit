<check_type:"Unix">

# Gerado de 03_Hardening_2026_RHEL_LEGADO.xlsx.
# Escopo: Red Hat Enterprise Linux 6.x e Oracle Linux 6.x.
# IDs ausentes na origem permanecem ausentes; não houve renumeração.

<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-001 | Bloqueio cramfs | Criticidade: Alta | RHEL6 LEGADO"
  info        : "Verificar se módulo cramfs está bloqueado. Bloquear módulo cramfs persistentemente via modprobe.d e remover se carregado."
  solution    : "Bloquear módulo cramfs persistentemente via modprobe.d e remover se carregado."
  reference   : "03_Hardening_2026_RHEL_LEGADO.xlsx | ID 1 | Kernel | Perfil Light | RHEL6 LEGADO"
  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( ( ! modinfo cramfs >/dev/null 2>&1 ) || ( modprobe -n -v cramfs 2>/dev/null | grep -Eq '^[[:space:]]*install[[:space:]]+/bin/(true|false)([[:space:]]|$)' && ! lsmod | awk '{print $1}' | grep -qx 'cramfs' ) ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

