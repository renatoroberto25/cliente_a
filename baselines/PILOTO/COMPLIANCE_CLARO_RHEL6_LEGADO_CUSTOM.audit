  cmd         : "( awk -F: '$3>=500 && $1!=\"nfsnobody\" && $7!~/(nologin|false)$/ {print $1, $6}' /etc/passwd | while read u h; do [ ! -d \"$h\" ] || [ \"$(stat -c %U \"$h\")\" = \"$u\" ] || exit 1; done ) && echo PASS || echo FAIL"
