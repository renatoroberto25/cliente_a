<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-014 | SUID dump desabilitado | Criticidade: Alta | RHEL6 LEGADO"
  info        : "Verificar valor runtime e persistente de fs.suid_dumpable. Configurar fs.suid_dumpable=0 persistentemente."
  solution    : "Configurar fs.suid_dumpable=0 persistentemente."
  reference   : "03_Hardening_2026_RHEL_LEGADO.xlsx | ID 14 | Kernel | Perfil Light | RHEL6 LEGADO"
  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( [ \"$(sysctl -n fs.suid_dumpable 2>/dev/null)\" = \"0\" ] ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

