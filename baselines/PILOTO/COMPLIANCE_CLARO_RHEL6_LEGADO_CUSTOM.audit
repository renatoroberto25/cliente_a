<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-190 | Permissões de /etc/gshadow | Criticidade: Alta | RHEL6 LEGADO"
  info        : "Verificar permissões de /etc/gshadow. Garantir permissões restritas no /etc/gshadow."
  solution    : "Garantir permissões restritas no /etc/gshadow."
  reference   : "03_Hardening_2026_RHEL_LEGADO.xlsx | ID 190 | Sistema | Perfil Light | RHEL6 LEGADO"
  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( stat -c '%a %u %g' /etc/gshadow 2>/dev/null | grep -Eq '^(0|400|600|640) 0 0$' ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>
