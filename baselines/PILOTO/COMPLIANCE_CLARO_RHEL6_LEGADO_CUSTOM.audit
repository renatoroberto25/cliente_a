<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-172 | SUID SGID revisados | Criticidade: Alta | RHEL6 LEGADO"
  info        : "Listar arquivos SUID SGID locais. Revisar binários SUID e SGID fora do baseline."
  solution    : "Revisar binários SUID e SGID fora do baseline."
  reference   : "03_Hardening_2026_RHEL_LEGADO.xlsx | ID 172 | Permissões | Perfil Full | RHEL6 LEGADO"
  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( a=$(mktemp /tmp/rhel6_suid.XXXXXX) && b=$(mktemp /tmp/rhel6_suid_rpm.XXXXXX) || exit 1; find / -xdev -type f \\( -perm -4000 -o -perm -2000 \\) -print 2>/dev/null | sort > \"$a\"; rpm -Va 2>/dev/null | awk '$1~/[SM5DLUGTP]/ && $2~/[ug]/ {print $NF}' | sort > \"$b\"; diff -q \"$a\" \"$b\" >/dev/null 2>&1; rc=$?; rm -f \"$a\" \"$b\"; [ $rc -eq 0 ] ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "RHEL6-173 | Home ausente | Criticidade: Baixa | RHEL6 LEGADO"
