  see_also    : "Baseline RHEL Legado; validar exceções e suporte contratado"
  cmd         : "( p=$(su - root -c 'printf %s \"$PATH\"' 2>/dev/null); [ -n \"$p\" ] && ! echo \"$p\" | grep -Eq '(^|:)(\\.|[^:]*[[:space:]][^:]*|)(:|$)|::$' ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
