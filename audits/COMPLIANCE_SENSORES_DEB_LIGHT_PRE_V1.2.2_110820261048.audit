<custom_item>
  type        : CMD_EXEC
  description : "152, Permissões de /etc/passwd, Alta"
  info        : "Protege o arquivo principal de contas locais contra alteração indevida."
  solution    : "Corrigir proprietário e permissões preservando root:shadow onde previsto no Debian; revisar cada achado antes de alterar arquivos de aplicacao."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( stat -Lc '%a %u %g' /etc/passwd 2>/dev/null | grep -Eq '^(600|640|644) 0 0$' ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
