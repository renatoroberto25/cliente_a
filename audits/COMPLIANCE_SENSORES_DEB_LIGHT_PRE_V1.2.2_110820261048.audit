<check_type:"Unix">

<custom_item>
  type        : CMD_EXEC
  description : "001, Bloqueio cramfs, Alta"
  info        : "Reduz superfície de ataque removendo suporte a filesystem legado raramente necessário."
  solution    : "Criar regra em /etc/modprobe.d com install /bin/false e blacklist; descarregar o módulo somente após validar dependências."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if modinfo cramfs >/dev/null 2>&1; then if modinfo cramfs >/dev/null 2>&1; then if modinfo cramfs >/dev/null 2>&1; then ( ! modinfo cramfs >/dev/null 2>&1 || { modprobe -n -v cramfs 2>/dev/null | grep -Eq '^install[[:space:]]+(/usr)?/bin/(true|false)([[:space:]]|$)' && ! lsmod | awk '{print $1}' | grep -qx cramfs; } ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>





