  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if for u in cron.service cron.socket; do systemctl list-unit-files \"$u\" --no-legend 2>/dev/null | grep -q . && exit 0; done; exit 1 || command -v at >/dev/null 2>&1; then if for u in cron.service cron.socket; do systemctl list-unit-files \"$u\" --no-legend 2>/dev/null | grep -q . && exit 0; done; exit 1 || command -v at >/dev/null 2>&1; then if for u in cron.service cron.socket; do systemctl list-unit-files \"$u\" --no-legend 2>/dev/null | grep -q . && exit 0; done; exit 1 || command -v at >/dev/null 2>&1; then ( [ -f /etc/cron.allow ] && grep -qx root /etc/cron.allow && [ ! -e /etc/cron.deny ] && { ! command -v at >/dev/null 2>&1 || { [ -f /etc/at.allow ] && grep -qx root /etc/at.allow && [ ! -e /etc/at.deny ]; }; } ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "081, Redirects desabilitados, Alta"
  info        : "Impede redirecionamento malicioso de tráfego na rede."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n net.ipv4.conf.all.send_redirects 2>/dev/null)\" = 0 ] && [ \"$(sysctl -n net.ipv4.conf.default.send_redirects 2>/dev/null)\" = 0 ] ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

