<custom_item>
  type        : CMD_EXEC
  description : "014, Core dumps restritos, Alta"
  info        : "Restringe a geração de core dumps para evitar vazamento de informações sensíveis."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n fs.suid_dumpable 2>/dev/null)\" = \"0\" ] && grep -Eq '^[[:space:]]*fs\\.suid_dumpable[[:space:]]*=[[:space:]]*0([[:space:]]|$)' /etc/sysctl.d/99-hitss-hardening.conf 2>/dev/null && awk -F= -v key='fs.suid_dumpable' -v expected='0' '{ name=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",name); if (name==key) { value=$2; sub(/[[:space:]]*[#;].*$/,\"\",value); gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",value) } } END { exit value != expected }' /etc/sysctl.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "015, SUID dump off, Alta"
  info        : "Evita que processos SUID gerem dumps com conteúdo sensível gravado em disco."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n fs.suid_dumpable 2>/dev/null)\" = \"0\" ] && grep -Eq '^[[:space:]]*fs\\.suid_dumpable[[:space:]]*=[[:space:]]*0([[:space:]]|$)' /etc/sysctl.d/99-hitss-hardening.conf 2>/dev/null && awk -F= -v key='fs.suid_dumpable' -v expected='0' '{ name=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",name); if (name==key) { value=$2; sub(/[[:space:]]*[#;].*$/,\"\",value); gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",value) } } END { exit value != expected }' /etc/sysctl.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "016, NX/XD ativo, Alta"
  info        : "Garante que a execução de código em áreas de memória não é permitida."
  solution    : "Ajustar o controle 'NX/XD ativo' conforme a política aprovada para Debian-like 11+."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( case \"$(uname -m)\" in x86_64|i?86) grep -qw nx /proc/cpuinfo ;; *) grep -Eq '^CONFIG_STRICT_KERNEL_RWX=y' /boot/config-$(uname -r) 2>/dev/null ;; esac ) && echo PASS || echo NA && echo PASS || echo NA && echo PASS || echo NA"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "017, ASLR habilitado, Alta"
  info        : "Randomização de espaço de memória dificulta exploits baseados em endereço fixo."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n kernel.randomize_va_space 2>/dev/null)\" = \"2\" ] && grep -Eq '^[[:space:]]*kernel\\.randomize_va_space[[:space:]]*=[[:space:]]*2([[:space:]]|$)' /etc/sysctl.d/99-hitss-hardening.conf 2>/dev/null && awk -F= -v key='kernel.randomize_va_space' -v expected='2' '{ name=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",name); if (name==key) { value=$2; sub(/[[:space:]]*[#;].*$/,\"\",value); gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",value) } } END { exit value != expected }' /etc/sysctl.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "018, ASLR completo, Alta"
  info        : "Dificulta exploração de vulnerabilidades que dependem de previsibilidade de endereços."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n kernel.randomize_va_space 2>/dev/null)\" = \"2\" ] && grep -Eq '^[[:space:]]*kernel\\.randomize_va_space[[:space:]]*=[[:space:]]*2([[:space:]]|$)' /etc/sysctl.d/99-hitss-hardening.conf 2>/dev/null && awk -F= -v key='kernel.randomize_va_space' -v expected='2' '{ name=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",name); if (name==key) { value=$2; sub(/[[:space:]]*[#;].*$/,\"\",value); gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",value) } } END { exit value != expected }' /etc/sysctl.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>



<custom_item>
  type        : CMD_EXEC
  description : "020, dmesg restrito, Alta"
  info        : "Impede que usuários não privilegiados acessem informações internas do kernel."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n kernel.dmesg_restrict 2>/dev/null)\" = \"1\" ] && grep -Eq '^[[:space:]]*kernel\\.dmesg_restrict[[:space:]]*=[[:space:]]*1([[:space:]]|$)' /etc/sysctl.d/99-hitss-hardening.conf 2>/dev/null && awk -F= -v key='kernel.dmesg_restrict' -v expected='1' '{ name=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",name); if (name==key) { value=$2; sub(/[[:space:]]*[#;].*$/,\"\",value); gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",value) } } END { exit value != expected }' /etc/sysctl.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "021, Symlinks protegidos, Alta"
  info        : "Evita a criação de symlinks que possam ser usados para acessar arquivos fora do diretório permitido."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n fs.protected_symlinks 2>/dev/null)\" = \"1\" ] && grep -REq '^[[:space:]]*fs\\.protected_symlinks[[:space:]]*=[[:space:]]*1([[:space:]]|$)' /etc/sysctl.conf /etc/sysctl.d/*.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "022, Hardlinks protegidos, Alta"
  info        : "Mitiga abuso de hardlinks para burlar controles de permissões."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n fs.protected_hardlinks 2>/dev/null)\" = \"1\" ] && grep -REq '^[[:space:]]*fs\\.protected_hardlinks[[:space:]]*=[[:space:]]*1([[:space:]]|$)' /etc/sysctl.conf /etc/sysctl.d/*.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>































<custom_item>
  type        : CMD_EXEC
  description : "038, Sticky world-writable, Alta"
  info        : "Impede exclusão de arquivos por usuários não proprietários em diretórios compartilhados."
  solution    : "Ajustar /etc/fstab ou unidade .mount com as opções requeridas; executar em janela com plano de rollback e validação de boot."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( ! find / -xdev -type d -perm -0002 ! -perm -1000 -print -quit 2>/dev/null | grep -q . ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "039, Sticky /tmp, Média"
  info        : "Protege arquivos temporários contra exclusão indevida por outros usuários."
  solution    : "Ajustar /etc/fstab ou unidade .mount com as opções requeridas; executar em janela com plano de rollback e validação de boot."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( stat -Lc '%a %u %g' /tmp 2>/dev/null | grep -Eq '^1[0-7][0-7][0-7] 0 0$' ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "040, Sticky /var/tmp, Média"
  info        : "Garante proteção semelhante ao /tmp para área temporária persistente."
  solution    : "Ajustar /etc/fstab ou unidade .mount com as opções requeridas; executar em janela com plano de rollback e validação de boot."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( stat -Lc '%a %u %g' /var/tmp 2>/dev/null | grep -Eq '^1[0-7][0-7][0-7] 0 0$' ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "041, Sticky /dev/shm, Média"
  info        : "Protege memória compartilhada contra manipulação indevida quando exigido."
  solution    : "Ajustar /etc/fstab ou unidade .mount com as opções requeridas; executar em janela com plano de rollback e validação de boot."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( stat -Lc '%a %u %g' /dev/shm 2>/dev/null | grep -Eq '^1[0-7][0-7][0-7] 0 0$' ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>





<custom_item>
  type        : CMD_EXEC
  description : "044, Permissões seguras no arquivo do bootloader, Alta"
  info        : "Garante que o arquivo do bootloader tenha permissões seguras configuradas."
  solution    : "Ajustar /etc/default/grub ou /etc/default/grub.d, executar update-grub e validar console e boot antes de reiniciar."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if [ -f /boot/grub/grub.cfg ]; then if [ -f /boot/grub/grub.cfg ]; then if [ -f /boot/grub/grub.cfg ]; then ( stat -Lc '%a %u %g' /boot/grub/grub.cfg 2>/dev/null | grep -Eq '^(400|600) 0 0$' ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "045, Single user mode com autenticação, Média"
  info        : "Garante que o modo de usuário único tenha autenticação configurada. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Ajustar /etc/default/grub ou /etc/default/grub.d, executar update-grub e validar console e boot antes de reiniciar."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if for u in emergency.service rescue.service; do systemctl list-unit-files \"$u\" --no-legend 2>/dev/null | grep -q . && exit 0; done; exit 1; then if for u in emergency.service rescue.service; do systemctl list-unit-files \"$u\" --no-legend 2>/dev/null | grep -q . && exit 0; done; exit 1; then if for u in emergency.service rescue.service; do systemctl list-unit-files \"$u\" --no-legend 2>/dev/null | grep -q . && exit 0; done; exit 1; then ( ! systemctl cat emergency.service rescue.service 2>/dev/null | grep -Eq 'ExecStart=-?/(bin|usr/bin)/(sh|bash)([[:space:]]|$)' ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "046, Prelink removido, Média"
  info        : "Evita inconsistências com mecanismos modernos de proteção de memória."
  solution    : "Remover prelink quando presente. Usar apt/dpkg e systemctl; não remover serviço que corresponda a função aprovada do host."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' prelink 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' prelink 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' prelink 2>/dev/null | grep -q '^ii '; then ( ! dpkg-query -W -f='${binary:Package} ${db:Status-Abbrev}\\n' prelink 2>/dev/null | grep -Eq '[[:space:]]ii[[:space:]]*$' ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "047, xinetd removido, Alta"
  info        : "Remove gerenciador de serviços legado potencialmente vulnerável."
  solution    : "Ajustar o controle 'xinetd removido' conforme a política aprovada para Debian-like 11+. Usar apt/dpkg e systemctl; não remover serviço que corresponda a função aprovada do host."
