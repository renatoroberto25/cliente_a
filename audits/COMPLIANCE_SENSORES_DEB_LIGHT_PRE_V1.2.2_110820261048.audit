<custom_item>
  type        : CMD_EXEC
  description : "100, ClientAlive configurado, Média"
  info        : "Encerra sessões inativas reduzindo risco de hijacking."
  solution    : "Aplicar em /etc/ssh/sshd_config.d/99-hardening.conf, validar com sshd -t e sshd -T e recarregar ssh somente com sessão de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if command -v sshd >/dev/null 2>&1 && [ -f /etc/ssh/sshd_config ]; then if command -v sshd >/dev/null 2>&1 && [ -f /etc/ssh/sshd_config ]; then if command -v sshd >/dev/null 2>&1 && [ -f /etc/ssh/sshd_config ]; then ( i=$(sshd -T 2>/dev/null | awk '$1==\"clientaliveinterval\"{print $2; exit}'); c=$(sshd -T 2>/dev/null | awk '$1==\"clientalivecountmax\"{print $2; exit}'); [ -n \"$i\" ] && [ \"$i\" -ge 1 ] && [ \"$i\" -le 900 ] && [ -n \"$c\" ] && [ \"$c\" -ge 0 ] && [ \"$c\" -le 3 ] ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

