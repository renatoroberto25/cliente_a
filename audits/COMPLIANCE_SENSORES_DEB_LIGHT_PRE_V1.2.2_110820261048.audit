  description : "120, Datas de senha consistentes, Alta"
  info        : "Evita contas locais ativas com data de última troca de senha no futuro."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then ( now=$(($(date +%s)/86400)); awk -F: -v n=\"$now\" '$2 ~ /^\\$/ && $3>n {bad=1} END{exit bad}' /etc/shadow ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "121, Apenas root com UID 0, Alta"
  info        : "Evita existência de contas privilegiadas adicionais com UID 0."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(awk -F: '$3==0{print $1}' /etc/passwd)\" = root ] ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "122, Apenas grupo root com GID 0, Alta"
  info        : "Evita existência de grupos privilegiados adicionais com GID 0."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(awk -F: '$3==0{print $1}' /etc/group)\" = root ] ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "123, Contas de sistema com shell inválido bloqueadas, Alta"
  info        : "Evita login interativo em contas de sistema."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( uid_min=$(awk '$1==\"UID_MIN\"{print $2; exit}' /etc/login.defs); awk -F: -v m=\"${uid_min:-1000}\" '$1 !~ /^(root|sync|shutdown|halt)$/ && $3<m && $7 !~ /(nologin|false)$/ {bad=1} END{exit bad}' /etc/passwd ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "124, /etc/shells validado, Média"
  info        : "Evita exposição de shells não aprovados no sistema."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( awk '!/^[[:space:]]*(#|$)/{print}' /etc/shells | while read -r s; do [ -x \"$s\" ] && [ \"$(stat -Lc %u \"$s\")\" -eq 0 ] && [ $((8#$(stat -Lc %a \"$s\") & 0022)) -eq 0 ] || exit 1; done ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "125, PATH do root sem diretório inseguro, Alta"
  info        : "Evita uso de diretório corrente no PATH do root."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( p=$(getent passwd root | cut -d: -f7); path=$(env -i HOME=/root \"$p\" -lc 'printf %s \"$PATH\"' 2>/dev/null); oldifs=$IFS; IFS=:; for d in $path; do [ -n \"$d\" ] && [ \"$d\" != . ] && [ -d \"$d\" ] && [ \"$(stat -Lc %u \"$d\")\" -eq 0 ] && [ $((8#$(stat -Lc %a \"$d\") & 0022)) -eq 0 ] || exit 1; done; IFS=$oldifs ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "126, Umask padrão restritiva, Alta"
  info        : "Define criação padrão de arquivos e diretórios com permissões mais restritivas."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( grep -REq '^[[:space:]]*umask[[:space:]]+0(27|77)([[:space:]]|$)' /etc/profile /etc/bash.bashrc /etc/profile.d/*.sh 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "127, Timeout de shell, Média"
  info        : "Encerra sessões inativas de shell reduzindo exposição por abandono de terminal. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( grep -REq '^[[:space:]]*TMOUT=([1-8]?[0-9]{1,2}|900)([[:space:]]|$)' /etc/profile /etc/bash.bashrc /etc/profile.d/*.sh 2>/dev/null && grep -REq '^[[:space:]]*(readonly|export)[[:space:]]+TMOUT' /etc/profile /etc/bash.bashrc /etc/profile.d/*.sh 2>/dev/null ) && echo PASS || echo NA && echo PASS || echo NA && echo PASS || echo NA"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "128, Administração privilegiada via sudo restrita, Alta"
  info        : "Centraliza privilégio administrativo em grupo autorizado."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then ( grep -REq '^[[:space:]]*%sudo[[:space:]]+ALL[[:space:]]*=[[:space:]]*\\(ALL(:ALL)?\\)[[:space:]]+ALL([[:space:]]|$)' /etc/sudoers /etc/sudoers.d/* 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "129, Sudo com pseudo-TTY, Alta"
  info        : "Reduz riscos de execução de sudo sem terminal controlado e melhora a rastreabilidade."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then ( grep -REq '^[[:space:]]*Defaults([[:space:]]+|:)[^#]*use_pty([[:space:],]|$)' /etc/sudoers /etc/sudoers.d/* 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "130, Logging de sudo habilitado, Alta"
  info        : "Registra uso de sudo em arquivo dedicado para auditoria. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then ( grep -REq '^[[:space:]]*Defaults([[:space:]]+|:)[^#]*logfile=' /etc/sudoers /etc/sudoers.d/* 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "131, Timeout de autenticação sudo, Média"
  info        : "Limita tempo de reaproveitamento de credencial sudo."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then ( v=$(grep -REh '^[[:space:]]*Defaults([[:space:]]+|:)[^#]*timestamp_timeout=' /etc/sudoers /etc/sudoers.d/* 2>/dev/null | tail -1 | sed -E 's/.*timestamp_timeout=([0-9]+).*/\\1/'); [ -n \"$v\" ] && [ \"$v\" -ge 0 ] && [ \"$v\" -le 15 ] ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>



<custom_item>
  type        : CMD_EXEC
  description : "133, Journald persistente, Alta"
  info        : "Mantém persistência de logs locais no journald."
  solution    : "Ajustar journald, rsyslog, logrotate ou auditd conforme o item; validar retenção, espaco e inicialização do serviço."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if systemctl --version >/dev/null 2>&1; then ( cfg=$(systemd-analyze cat-config systemd/journald.conf 2>/dev/null | awk -F= '/^[[:space:]]*Storage[[:space:]]*=/{gsub(/[[:space:]]/,\"\",$2); v=tolower($2)} END{print v}'); { [ \"$cfg\" = persistent ] || { { [ -z \"$cfg\" ] || [ \"$cfg\" = auto ]; } && [ -d /var/log/journal ]; }; } ) && echo PASS || echo FAIL; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "134, Rsyslog habilitado, Alta"
  info        : "Garante serviço rsyslog habilitado para coleta e encaminhamento de logs. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Ajustar journald, rsyslog, logrotate ou auditd conforme o item; validar retenção, espaco e inicialização do serviço."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' rsyslog 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' rsyslog 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' rsyslog 2>/dev/null | grep -q '^ii '; then ( systemctl is-enabled --quiet rsyslog.service 2>/dev/null && systemctl is-active --quiet rsyslog.service 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "135, Rotação de logs configurada, Média"
  info        : "Mantém retenção e renovação periódica dos logs locais."
  solution    : "Ajustar journald, rsyslog, logrotate ou auditd conforme o item; validar retenção, espaco e inicialização do serviço."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' logrotate 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' logrotate 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' logrotate 2>/dev/null | grep -q '^ii '; then ( dpkg-query -W -f='${db:Status-Abbrev}' logrotate 2>/dev/null | grep -q '^ii ' && grep -Eq '^[[:space:]]*rotate[[:space:]]+[1-9][0-9]*' /etc/logrotate.conf 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "136, auditd habilitado, Alta"
  info        : "Garante serviço de auditoria habilitado no sistema."
  solution    : "Ajustar journald, rsyslog, logrotate ou auditd conforme o item; validar retenção, espaco e inicialização do serviço."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then ( dpkg-query -W -f='${db:Status-Abbrev}' auditd 2>/dev/null | grep -q '^ii ' && systemctl is-enabled --quiet auditd.service 2>/dev/null && systemctl is-active --quiet auditd.service 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "137, Auditoria habilitada desde o boot, Alta"
  info        : "Garante coleta de eventos desde o início do boot por meio do parâmetro audit=1. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Ajustar /etc/default/grub ou /etc/default/grub.d, executar update-grub e validar console e boot antes de reiniciar."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then ( grep -qw audit=1 /proc/cmdline && grep -REq '^[[:space:]]*GRUB_CMDLINE_LINUX(_DEFAULT)?=.*audit=1' /etc/default/grub /etc/default/grub.d/*.cfg 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "138, max_log_file configurado, Alta"
  info        : "Define tamanho máximo do arquivo de auditoria antes de ação rotativa."
  solution    : "Ajustar journald, rsyslog, logrotate ou auditd conforme o item; validar retenção, espaco e inicialização do serviço."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then ( grep -Eq '^[[:space:]]*max_log_file[[:space:]]*=[[:space:]]*[1-9][0-9]*' /etc/audit/auditd.conf 2>/dev/null && grep -Eq '^[[:space:]]*max_log_file_action[[:space:]]*=[[:space:]]*(ROTATE|KEEP_LOGS)([[:space:]]|$)' /etc/audit/auditd.conf 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "139, Auditoria de data e hora, Alta"
  info        : "Registra alterações relevantes de data e hora no sistema. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Adicionar regra em /etc/audit/rules.d/50-hardening.rules e carregar com augenrules --load; medir volume antes de tornar imutavel."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then ( files='/etc/audit/rules.d/*.rules /etc/audit/audit.rules'; grep -REq -- '/etc/localtime' $files 2>/dev/null && for s in adjtimex settimeofday clock_settime; do grep -REq -- \"(^|[,[:space:]])$s([,[:space:]]|$)\" $files 2>/dev/null || exit 1; done ) && echo PASS || echo FAIL; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "140, Auditoria de contas e grupos, Alta"
  info        : "Registra alterações em arquivos críticos de contas e grupos."
  solution    : "Adicionar regra em /etc/audit/rules.d/50-hardening.rules e carregar com augenrules --load; medir volume antes de tornar imutavel."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then ( files='/etc/audit/rules.d/*.rules /etc/audit/audit.rules'; for f in /etc/passwd /etc/group /etc/shadow /etc/gshadow; do grep -REq -- \"-w[[:space:]]+$f([[:space:]]|$)\" $files 2>/dev/null || exit 1; done ) && echo PASS || echo FAIL; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "141, Auditoria de rede, Alta"
  info        : "Registra alterações em arquivos críticos de configuração de rede. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Adicionar regra em /etc/audit/rules.d/50-hardening.rules e carregar com augenrules --load; medir volume antes de tornar imutavel."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then ( files='/etc/audit/rules.d/*.rules /etc/audit/audit.rules'; for f in /etc/hosts /etc/hostname /etc/resolv.conf; do grep -REq -- \"-w[[:space:]]+$f([[:space:]]|$)\" $files 2>/dev/null || exit 1; done ) && echo PASS || echo FAIL; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "142, Auditoria de login, Alta"
  info        : "Registra eventos de autenticação e sessão. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Adicionar regra em /etc/audit/rules.d/50-hardening.rules e carregar com augenrules --load; medir volume antes de tornar imutavel."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if dpkg-query -W -f='${db:Status-Abbrev}\\n' auditd 2>/dev/null | grep -q '^ii '; then ( files='/etc/audit/rules.d/*.rules /etc/audit/audit.rules'; for f in /var/log/lastlog /var/log/wtmp /var/log/btmp; do grep -REq -- \"-w[[:space:]]+$f([[:space:]]|$)\" $files 2>/dev/null || exit 1; done ) && echo PASS || echo FAIL; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "143, Auditoria de permissões, Média"
  info        : "Registra mudanças relevantes de permissões e propriedades. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Adicionar regra em /etc/audit/rules.d/50-hardening.rules e carregar com augenrules --load; medir volume antes de tornar imutavel."
