  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n net.ipv4.conf.all.accept_redirects 2>/dev/null)\" = 0 ] && [ \"$(sysctl -n net.ipv4.conf.default.accept_redirects 2>/dev/null)\" = 0 ] && { [ ! -e /proc/sys/net/ipv6/conf/all/accept_redirects ] || { [ \"$(sysctl -n net.ipv6.conf.all.accept_redirects 2>/dev/null)\" = 0 ] && [ \"$(sysctl -n net.ipv6.conf.default.accept_redirects 2>/dev/null)\" = 0 ]; }; } ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>



<custom_item>
  type        : CMD_EXEC
  description : "085, Broadcast ICMP ignorado, Alta"
  info        : "Reduz exposição a ataques via broadcast ICMP."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( [ \"$(sysctl -n net.ipv4.icmp_echo_ignore_broadcasts 2>/dev/null)\" = \"1\" ] && grep -REq '^[[:space:]]*net\\.ipv4\\.icmp_echo_ignore_broadcasts[[:space:]]*=[[:space:]]*1([[:space:]]|$)' /etc/sysctl.conf /etc/sysctl.d/*.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
