  solution    : "Aplicar blacklist e install neutro para rds"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'if modinfo rds >/dev/null 2>&1; then modprobe -n -v rds | grep -Eq \"install\\\\s+|blacklist\" && ! lsmod | grep -qw rds && echo PASS || echo FAIL; else echo PASS; fi'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "013, Bloqueio TIPC, Alta"
  info        : "Evita exposicao de protocolo de cluster pouco utilizado"
  solution    : "Adicionar entradas de blacklist e install neutro para tipc"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'if modinfo tipc >/dev/null 2>&1; then modprobe -n -v tipc | grep -Eq \"install\\\\s+|blacklist\" && ! lsmod | grep -qw tipc && echo PASS || echo FAIL; else echo PASS; fi'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "014, Core dumps restritos, Alta"
  info        : "Restringe a geração de core dumps para evitar vazamento de informações sensíveis"
  solution    : "Configurar sysctl para restringir a geração de core dumps"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'sysctl -n fs.suid_dumpable 2>/dev/null | grep -qx 0 && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "015, SUID dump off, Alta"
  info        : "Evita que processos SUID gerem dumps com conteúdo sensível gravado em disco"
  solution    : "Configurar sysctl persistente"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sysctl -n fs.suid_dumpable"
  expect      : "^0$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "016, NX/XD ativo, Alta"
  info        : "Garante que a execução de código em áreas de memória não é permitida"
  solution    : "Verificar se o suporte a NX/XD está ativado no kernel"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'grep -qw nx /proc/cpuinfo && dmesg 2>/dev/null | grep -qi \"nx.*active\" && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "017, ASLR habilitado, Média"
  info        : "Randomização de espaço de memória dificulta exploits baseados em endereço fixo"
  solution    : "Configurar sysctl kernel randomize va space igual a dois(habilitar ASLR)"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'sysctl -n kernel.randomize_va_space 2>/dev/null | grep -qx 2 && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "018, ASLR completo, Média"
  info        : "Dificulta exploração de vulnerabilidades que dependem de previsibilidade de endereços"
  solution    : "Configurar sysctl persistente"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sysctl -n kernel.randomize_va_space"
  expect      : "^2$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "019, perf_event restrito, Média"
  info        : "Perf counters podem ser usados para side channel e coleta de informacao de kernel"
  solution    : "Ajustar sysctl kernel perf event paranoid para valor dois ou tres"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'sysctl -n kernel.perf_event_paranoid 2>/dev/null | grep -Eq \"^[23]$\" && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "021, dmesg restrito, Alta"
  info        : "Impede que usuários não privilegiados acessem informações internas do kernel"
  solution    : "Configurar sysctl persistente"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sysctl -n kernel.dmesg_restrict"
  expect      : "^1$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "022, Symlinks protegidos, Alta"
  info        : "Evita a criação de symlinks que possam ser usados para acessar arquivos fora do diretório permitido"
  solution    : "Configurar sysctl fs.protected_symlinks para valor 1"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'sysctl -n fs.protected_symlinks 2>/dev/null | grep -qx 1 && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "024, Hardlinks protegidos, Alta"
  info        : "Mitiga abuso de hardlinks para burlar controles de permissões"
  solution    : "Configurar sysctl persistente"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sysctl -n fs.protected_hardlinks"
  expect      : "^1$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "025, Partição dedicada para /tmp, Média"
  info        : "Garante que o diretório /tmp tenha sua própria partição para evitar uso excessivo de espaço em disco"
  solution    : "Configurar uma partição dedicada para /tmp"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
