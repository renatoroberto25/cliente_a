  type        : CMD_EXEC
  description : "186, Permissões de /etc/passwd-, Média"
  info        : "Protege a cópia de segurança de contas locais contra alteração indevida"
  solution    : "Ajustar permissões de /etc/passwd-"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
