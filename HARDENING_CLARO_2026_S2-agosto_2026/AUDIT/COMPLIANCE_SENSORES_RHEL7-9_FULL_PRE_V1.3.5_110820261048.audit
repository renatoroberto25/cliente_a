<custom_item>
  type        : CMD_EXEC
  description : "187, Permissões de /etc/shadow, Alta"
  info        : "Protege o arquivo de senhas locais contra leitura ou alteração indevida"
  solution    : "Ajustar permissões de /etc/shadow"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "stat -c '%a %U %G' /etc/shadow 2>/dev/null"
