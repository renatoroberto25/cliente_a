<custom_item>
  type        : CMD_EXEC
  description : "195, Arquivos órfãos inexistentes, Média"
  info        : "Evita presença de arquivos locais sem proprietário válido"
  solution    : "Corrigir arquivos órfãos"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( find / -xdev -nouser 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "196, Sticky bit em diretórios world writable, Alta"
  info        : "Impede exclusão indevida em diretórios compartilhados com escrita global"
  solution    : "Garantir sticky bit em diretórios world writable"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( find / -xdev -type d -perm -0002 ! -perm -1000 2>/dev/null | while read -r dir; do [ \"$(findmnt -n -T \"$dir\" -o FSTYPE 2>/dev/null)\" = \"vboxsf\" ] || echo \"$dir\"; done | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "197, Sem arquivos sem owner ou grupo, Média"
  info        : "Evita presença de arquivos locais sem owner ou grupo válido"
  solution    : "Corrigir arquivos sem owner ou grupo"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( find / -xdev \\( -nouser -o -nogroup \\) 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "198, SUID/SGID indevidos, Alta"
  info        : "Garante que SUID/SGID estejam configurados corretamente"
  solution    : "Ajustar permissões de arquivos executáveis"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "bad=0; while IFS= read -r file; do case \"$file\" in /usr/bin/sudo|/usr/bin/su) ;; *) bad=1; printf \"%s\\n\" \"$file\";; esac; done < <(find / -xdev -type f \\( -perm -4000 -o -perm -2000 \\) 2>/dev/null); [ \"$bad\" -eq 0 ] && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "199, Usuários sem home inexistentes, Média"
  info        : "Evita contas locais interativas sem diretório home válido"
  solution    : "Verificar usuários sem diretório home"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( awk -F: '$3>=1000 && $7!=\"/sbin/nologin\" && $7!=\"/bin/false\"{print $6}' /etc/passwd | while read h; do [ -d \"$h\" ] || echo \"$h\"; done | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "200, Ownership correto dos homes, Alta"
  info        : "Garante que cada diretório home pertença ao usuário esperado"
  solution    : "Ajustar ownership dos diretórios home"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( awk -F: '$3>=1000 && $7!=\"/sbin/nologin\" && $7!=\"/bin/false\"{print $1\":\"$6}' /etc/passwd | while IFS=: read u h; do [ -d \"$h\" ] && [ \"$(stat -c %U \"$h\" 2>/dev/null)\" = \"$u\" ] || echo \"$u:$h\"; done | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "201, Permissões de home restritivas, Alta"
  info        : "Evita diretórios home com permissões excessivas"
  solution    : "Ajustar permissões de home para 750"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( find /home -mindepth 1 -maxdepth 1 -type d -perm /027 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "202, Dotfiles sem permissão world writable, Média"
  info        : "Evita exposição ou alteração indevida de arquivos ocultos em home"
  solution    : "Ajustar permissões de dotfiles"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( find /home -maxdepth 2 -type f -name '.*' -perm -002 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "203, Sem arquivos .forward .netrc e .rhosts, Alta"
  info        : "Evita mecanismos legados inseguros em diretórios home"
  solution    : "Remover arquivos .forward .netrc, .rhosts"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( find /home -maxdepth 2 -type f \\( -name '.forward' -o -name '.netrc' -o -name '.rhosts' \\) 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "999, Verificacao de hardening aplicado (log local)"
  info        : "Verifica se existe log local de execucao do hardening e mostra o ultimo registro."
  solution    : "Executar a automacao de hardening para criar /var/log/hitss-hardening.log."
  reference   : "BASELINE"
  see_also    : "/var/log/hitss-hardening.log"
  cmd         : "sh -c 'log=/var/log/hitss-hardening.log; [ -f \"$log\" ] || { echo \"FAIL | sem_log\"; exit; }; echo \"PASS | $(tail -n 1 \"$log\")\"'"
  expect      : "(?i)^\\s*PASS\\s*\\|"
</custom_item>

</check_type>