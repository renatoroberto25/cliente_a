  type        : CMD_EXEC
  description : "011, Bloqueio SCTP, Alta"
  info        : "Protocolo complexo aumenta superficie de ataque em ambientes que nao o usam"
  solution    : "Configurar blacklist para sctp exceto onde for requisito de aplicacao"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'if modinfo sctp >/dev/null 2>&1; then modprobe -n -v sctp | grep -Eq \"install\\\\s+|blacklist\" && ! lsmod | grep -qw sctp && echo PASS || echo FAIL; else echo PASS; fi'"
