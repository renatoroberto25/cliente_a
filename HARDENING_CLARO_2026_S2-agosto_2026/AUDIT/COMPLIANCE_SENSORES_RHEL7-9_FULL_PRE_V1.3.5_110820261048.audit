  type        : CMD_EXEC
  description : "194, Proteção de /etc/security/opasswd, Alta"
  info        : "Protege o histórico de senhas locais contra leitura ou alteração indevida"
  solution    : "Proteger /etc/security/opasswd"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
