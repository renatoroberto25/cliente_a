  cmd         : "bash -c 'audit_grep() { local pattern=\"$1\"; shift; grep -REiq -- \"$pattern\" \"$@\" 2>/dev/null && echo PASS || echo FAIL; }; export -f audit_grep; audit_grep \"^[[:space:]]*Defaults[[:space:]]+timestamp_timeout=[1-9][0-9]*\\b\" /etc/sudoers /etc/sudoers.d'"
