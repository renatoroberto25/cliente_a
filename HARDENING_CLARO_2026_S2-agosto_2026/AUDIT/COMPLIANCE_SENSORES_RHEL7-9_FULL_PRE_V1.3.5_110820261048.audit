  solution    : "Manter apenas um mecanismo de sincronização ativo"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "printf '%s %s\\n' \"$(systemctl is-active chronyd 2>/dev/null || echo inactive)\" \"$(systemctl is-active ntpd 2>/dev/null || echo inactive)\""
  expect      : "^active inactive$|^inactive active$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "090, Cron e at restritos, Alta"
  info        : "Restringir cron e at a usuários autorizados"
  solution    : "Restringir acesso conforme política de usuários autorizados"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( [ -f /etc/cron.allow ] && [ -f /etc/at.allow ] && grep -qx root /etc/cron.allow && grep -qx root /etc/at.allow ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "092, Redirects desabilitados, Alta"
  info        : "Impede redirecionamento malicioso de tráfego na rede"
  solution    : "Desabilitar redirects de pacotes via sysctl persistente"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "printf '%s %s %s\\n' $(sysctl -n net.ipv4.conf.all.send_redirects 2>/dev/null) $(sysctl -n net.ipv4.conf.default.send_redirects 2>/dev/null) $(grep -RE 'net\\\\.ipv4\\\\.conf\\\\.(all|default)\\\\.send_redirects[[:space:]]*=[[:space:]]*0' /etc/sysctl.conf /etc/sysctl.d/* 2>/dev/null | wc -l)"
  expect      : "^0 0 [1-9][0-9]*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "093, Source-route bloqueado, Média"
  info        : "Evita manipulação do caminho de pacotes por atacante"
  solution    : "Desabilitar source routed packets via sysctl persistente"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "printf '%s %s %s\\n' $(sysctl -n net.ipv4.conf.all.accept_source_route 2>/dev/null) $(sysctl -n net.ipv4.conf.default.accept_source_route 2>/dev/null) $(grep -RE 'net\\\\.ipv4\\\\.conf\\\\.(all|default)\\\\.accept_source_route[[:space:]]*=[[:space:]]*0' /etc/sysctl.conf /etc/sysctl.d/* 2>/dev/null | wc -l)"
  expect      : "^0 0 [1-9][0-9]*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "094, ICMP redirects desabilitados, Média"
  info        : "Evita aceitação de redirecionamentos ICMP maliciosos"
  solution    : "Desabilitar ICMP redirects via sysctl persistente"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "printf '%s %s %s\\n' $(sysctl -n net.ipv4.conf.all.accept_redirects 2>/dev/null) $(sysctl -n net.ipv4.conf.default.accept_redirects 2>/dev/null) $(grep -RE 'net\\\\.ipv4\\\\.conf\\\\.(all|default)\\\\.accept_redirects[[:space:]]*=[[:space:]]*0' /etc/sysctl.conf /etc/sysctl.d/* 2>/dev/null | wc -l)"
  expect      : "^0 0 [1-9][0-9]*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "095, Reverse path filtering habilitado, Alta"
  info        : "Ajuda a bloquear spoofing de IP com validação de rota reversa"
  solution    : "Habilitar reverse path filtering via sysctl persistente"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "printf '%s %s %s\\n' $(sysctl -n net.ipv4.conf.all.rp_filter 2>/dev/null) $(sysctl -n net.ipv4.conf.default.rp_filter 2>/dev/null) $(grep -RE 'net\\\\.ipv4\\\\.conf\\\\.(all|default)\\\\.rp_filter[[:space:]]*=[[:space:]]*1' /etc/sysctl.conf /etc/sysctl.d/* 2>/dev/null | wc -l)"
  expect      : "^1 1 [1-9][0-9]*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "096, Broadcast ICMP ignorado, Alta"
