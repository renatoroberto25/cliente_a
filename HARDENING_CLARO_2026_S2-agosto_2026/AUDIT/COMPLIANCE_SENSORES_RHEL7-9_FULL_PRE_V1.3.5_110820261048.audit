  cmd         : "printf '%s %s\\n' $(sysctl -n net.ipv4.icmp_echo_ignore_broadcasts 2>/dev/null) $(grep -RE 'net\\\\.ipv4\\\\.icmp_echo_ignore_broadcasts[[:space:]]*=[[:space:]]*1' /etc/sysctl.conf /etc/sysctl.d/* 2>/dev/null | wc -l)"
