<custom_item>
  type        : CMD_EXEC
  description : "086, PolicyKit endurecido, Alta"
  info        : "Evita regras permissivas no PolicyKit fora do baseline aprovado"
  solution    : "Configurar polkit conforme baseline aprovado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( grep -RE 'polkit\\\\.Result\\\\.YES|allow' /etc/polkit-1/rules.d/*.rules 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "087, GPG check habilitado, Média"
