  type        : CMD_EXEC
  description : "010, Bloqueio DCCP, Alta"
  info        : "Protocolo pouco usado adiciona codigo de rede desnecessario"
  solution    : "Adicionar entradas de blacklist e install neutro para dccp"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'if modinfo dccp >/dev/null 2>&1; then modprobe -n -v dccp | grep -Eq \"install\\\\s+|blacklist\" && ! lsmod | grep -qw dccp && echo PASS || echo FAIL; else echo PASS; fi'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

