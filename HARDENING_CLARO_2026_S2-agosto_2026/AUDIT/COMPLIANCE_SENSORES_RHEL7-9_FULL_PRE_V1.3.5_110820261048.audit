<custom_item>
  type        : CMD_EXEC
  description : "181, Auditoria imutável, Alta"
  info        : "Garante que a auditoria esteja imutável"
  solution    : "Configurar auditoria imutável"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'auditctl -s 2>/dev/null | grep -Eq \"enabled\\\\s+2\" || grep -REq \"^[[:space:]]*-e[[:space:]]+2[[:space:]]*$\" /etc/audit/rules.d 2>/dev/null; [ $? -eq 0 ] && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "183, Verificação periódica de integridade, Alta"
