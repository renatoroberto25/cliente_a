  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( grep -L '^[[:space:]]*gpgcheck[[:space:]]*=[[:space:]]*1\\\\b' /etc/yum.repos.d/*.repo 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "089, Sincronização de tempo única, Alta"
