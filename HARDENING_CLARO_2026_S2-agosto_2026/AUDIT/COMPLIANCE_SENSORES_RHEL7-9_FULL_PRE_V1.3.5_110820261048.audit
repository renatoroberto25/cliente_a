  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'grep -Eq \"pam_pwquality\\\\.so.*(minlen=|dcredit=|ucredit=|lcredit=|ocredit=)\" /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null || grep -Eq \"^[[:space:]]*(minlen|minclass)[[:space:]]*=\" /etc/security/pwquality.conf 2>/dev/null; [ $? -eq 0 ] && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

