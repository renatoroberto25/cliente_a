</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "007, Bloqueio freevxfs, Alta"
  info        : "Remove filesystem obsoleto pouco testado em cenários modernos de produção"
  solution    : "Bloquear módulo via modprobe.d e remover se carregado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "modprobe -n -v freevxfs"
  expect      : "FATAL: Module freevxfs not found|^install[[:space:]]+/bin/(true|false)"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "008, Desabilitar o modulo overlayfs, Média"
  info        : "Overlayfs pode ser abusado para esconder camadas de arquivos"
  solution    : "Aplicar blacklist para overlay em hosts que nao usam containers ou overlays"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'if modinfo overlay >/dev/null 2>&1; then modprobe -n -v overlay | grep -Eq \"install\\\\s+|blacklist\" && ! lsmod | grep -qw overlay && echo PASS || echo FAIL; else echo PASS; fi'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "009, Bloqueio usb_storage, Alta"
  info        : "Impede que dispositivos USB sejam usados para copiar ou trazer dados maliciosos"
  solution    : "Bloquear módulo via modprobe.d e remover se carregado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "modprobe -n -v usb_storage"
  expect      : "^install[[:space:]]+/bin/(true|false)"
</custom_item>

