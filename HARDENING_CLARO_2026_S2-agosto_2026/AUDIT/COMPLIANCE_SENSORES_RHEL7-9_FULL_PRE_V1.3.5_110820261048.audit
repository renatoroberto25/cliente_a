  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "155, Administração privilegiada via sudo restrita, Alta"
  info        : "Centraliza privilégio administrativo em grupo autorizado"
  solution    : "Restringir administração privilegiada via sudo"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
