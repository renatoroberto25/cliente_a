  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'systemctl is-enabled autofs >/dev/null 2>&1 && echo FAIL || echo PASS'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
