  description : "137, Sem repetição/sequência, Média"
  info        : "Impede uso de padrões triviais repetitivos ou sequenciais"
  solution    : "Configurar limites de repetição e sequência"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "grep -E '^[[:space:]]*(maxrepeat|maxsequence)[[:space:]]*=[[:space:]]*[1-9]+' /etc/security/pwquality.conf 2>/dev/null"
  expect      : "^[[:space:]]*(maxrepeat|maxsequence)[[:space:]]*=[[:space:]]*[1-9]+.*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "138, Dicionário ativo, Média"
  info        : "Evita uso de palavras comuns facilmente descobertas"
  solution    : "Habilitar verificação de dicionário quando aplicável"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "bash -c 'audit_grep() { local pattern=\"$1\"; shift; grep -REiq -- \"$pattern\" \"$@\" 2>/dev/null && echo PASS || echo FAIL; }; export -f audit_grep; audit_grep \"^[[:space:]]*dictcheck[[:space:]]*=[[:space:]]*1\\b\" /etc/security/pwquality.conf'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "139, Hash forte, Alta"
  info        : "Protege senhas armazenadas contra ataques offline"
  solution    : "Configurar algoritmo de hashing forte"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'grep -Eq \"^[[:space:]]*password[[:space:]]+(sufficient|required)[[:space:]]+pam_unix\\\\.so.*\\\\bsha512\\\\b\" /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null || grep -Eq \"^[[:space:]]*ENCRYPT_METHOD[[:space:]]+SHA512\\\\b\" /etc/login.defs 2>/dev/null; [ $? -eq 0 ] && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "140, Histórico de senhas, Média"
  info        : "Evita reuso imediato de credenciais antigas"
  solution    : "Configurar histórico de senha"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "bash -c 'audit_grep() { local pattern=\"$1\"; shift; grep -REiq -- \"$pattern\" \"$@\" 2>/dev/null && echo PASS || echo FAIL; }; export -f audit_grep; audit_grep \"pam_pwhistory\\.so.*remember=[1-9]+\" /etc/pam.d/system-auth /etc/pam.d/password-auth'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "142, Tempo desbloqueio, Alta"
  info        : "Define período de bloqueio adequado equilibrando segurança e usabilidade"
  solution    : "Configurar tempo de desbloqueio conforme política"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'grep -Eq \"pam_faillock\\\\.so.*unlock_time=[1-9]+\" /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null || grep -Eq \"^[[:space:]]*unlock_time[[:space:]]*=[[:space:]]*[1-9]+\" /etc/security/faillock.conf 2>/dev/null; [ $? -eq 0 ] && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "143, PASS_MAX_DAYS, Alta"
  info        : "Força renovação periódica de credenciais"
  solution    : "Configurar PASS_MAX_DAYS"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "grep -E '^[[:space:]]*PASS_MAX_DAYS[[:space:]]+[1-9][0-9]+' /etc/login.defs 2>/dev/null"
  expect      : "^[[:space:]]*PASS_MAX_DAYS[[:space:]]+[1-9][0-9]+.*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "144, PASS_MIN_DAYS, Média"
  info        : "Evita trocas sucessivas de senha para burlar histórico"
  solution    : "Configurar PASS_MIN_DAYS"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "grep -E '^[[:space:]]*PASS_MIN_DAYS[[:space:]]+[0-9]+' /etc/login.defs 2>/dev/null"
  expect      : "^[[:space:]]*PASS_MIN_DAYS[[:space:]]+[0-9]+.*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "145, PASS_WARN_AGE, Média"
  info        : "Notifica usuários antes da expiração evitando bloqueios inesperados"
  solution    : "Configurar PASS_WARN_AGE"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "grep -E '^[[:space:]]*PASS_WARN_AGE[[:space:]]+[1-9][0-9]*' /etc/login.defs 2>/dev/null"
  expect      : "^[[:space:]]*PASS_WARN_AGE[[:space:]]+[1-9][0-9]*.*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "146, INACTIVE configurado, Alta"
  info        : "Define inativação automática de contas locais após expiração da senha"
  solution    : "Configurar parâmetro INACTIVE para contas locais"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "useradd -D 2>/dev/null | grep -E '^INACTIVE=[1-9][0-9]*'"
  expect      : "^INACTIVE=[1-9][0-9]*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "147, Datas de senha consistentes, Média"
  info        : "Evita contas locais ativas com data de última troca de senha no futuro"
  solution    : "Corrigir datas inconsistentes de troca de senha"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( awk -F: '$2~/^\\\\$.+\\\\$/{print $1}' /etc/shadow | while read -r u; do l_change=$(date -d \"$(chage --list \"$u\" | grep \"^Last password change\" | cut -d: -f2 | grep -v \"never$\")\" +%s 2>/dev/null); [ -n \"$l_change\" ] && [ \"$l_change\" -gt \"$(date +%s)\" ] && echo \"$u\"; done | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "148, Apenas root com UID 0, Alta"
  info        : "Evita existência de contas privilegiadas adicionais com UID 0"
  solution    : "Garantir apenas root com UID 0"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "awk -F: '$3==0{print}' /etc/passwd 2>/dev/null"
  expect      : "^root:[^:]*:0:0:.*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "149, Apenas grupo root com GID 0, Alta"
  info        : "Evita existência de grupos privilegiados adicionais com GID 0"
  solution    : "Garantir apenas grupo root com GID 0"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "awk -F: '$3==0{print}' /etc/group 2>/dev/null"
  expect      : "^root:[^:]*:0:.*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "150, Contas de sistema com shell inválido bloqueadas, Alta"
  info        : "Evita login interativo em contas de sistema"
  solution    : "Bloquear contas de sistema com shell inválido"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( awk -F: '($3>0 && $3<1000 && $7!=\"/sbin/nologin\" && $7!=\"/bin/false\"){print}' /etc/passwd 2>/dev/null | grep -q . && echo \"FAIL\" || echo \"PASS\" )"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "151, /etc/shells validado, Média"
  info        : "Evita exposição de shells não aprovados no sistema"
  solution    : "Remover shells inválidos de /etc/shells"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'grep -qx \"/sbin/nologin\" /etc/shells 2>/dev/null && ! grep -Ev \"^(#|$|/bin/bash|/usr/bin/bash|/bin/sh|/usr/bin/sh|/sbin/nologin|/usr/sbin/nologin|/bin/false|/usr/bin/false)$\" /etc/shells 2>/dev/null | grep -q . && echo PASS || echo FAIL'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "152, PATH do root sem diretório inseguro, Alta"
  info        : "Evita uso de diretório corrente no PATH do root"
  solution    : "Ajustar PATH do root removendo diretórios inseguros"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "su - root -c 'echo \"$PATH\"' 2>/dev/null"
  expect      : "^(?!.*(^|:)\\.(?:$|:)).*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "153, Umask padrão restritiva, Alta"
  info        : "Define criação padrão de arquivos e diretórios com permissões mais restritivas"
  solution    : "Configurar umask restritiva padrão"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "bash -c 'audit_grep() { local pattern=\"$1\"; shift; grep -REiq -- \"$pattern\" \"$@\" 2>/dev/null && echo PASS || echo FAIL; }; export -f audit_grep; audit_grep \"^[[:space:]]*umask[[:space:]]+0[2-7][2-7]\\b\" /etc/profile /etc/bashrc /etc/profile.d'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "154, Timeout de shell, Média"
