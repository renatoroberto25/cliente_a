<custom_item>
  type        : CMD_EXEC
  description : "185, Permissões de /etc/passwd, Alta"
  info        : "Protege o arquivo principal de contas locais contra alteração indevida"
  solution    : "Ajustar permissões de /etc/passwd"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "stat -c '%a' /etc/passwd 2>/dev/null"
  expect      : "^[0-6]44$"
</custom_item>

