  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "sh -c 'printf \"%s | %s\\n\" \"$(stat -c \"%a %U %G\" /etc/ssh/sshd_config 2>/dev/null)\" \"$(stat -c \"%a %U %G\" /etc/ssh 2>/dev/null)\"'"
  expect      : "^(600|640) root root \\| (700|750) root root$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "111, SyslogFacility AUTHPRIV, Média"
