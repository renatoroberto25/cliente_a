  type        : CMD_EXEC
  description : "169, Auditoria de data e hora, Alta"
  info        : "Registra alterações relevantes de data e hora no sistema"
  solution    : "Auditar alterações de data e hora"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "bash -c 'audit_grep() { local pattern=\"$1\"; shift; grep -REiq -- \"$pattern\" \"$@\" 2>/dev/null && echo PASS || echo FAIL; }; export -f audit_grep; audit_grep \"\\b(adjtimex|settimeofday|clock_settime)\\b\" /etc/audit/rules.d'"
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "170, Auditoria de contas e grupos, Alta"
  info        : "Registra alterações em arquivos críticos de contas e grupos"
  solution    : "Auditar alterações de contas e grupos"
