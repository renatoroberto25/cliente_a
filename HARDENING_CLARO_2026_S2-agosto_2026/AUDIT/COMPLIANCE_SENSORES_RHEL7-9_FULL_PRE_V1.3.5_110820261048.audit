<check_type:"Unix">

<custom_item>
  type        : CMD_EXEC
  description : "001, Bloqueio cramfs, Alta"
  info        : "Reduz superfície de ataque removendo suporte a filesystem legado raramente necessário"
  solution    : "Bloquear módulo via modprobe.d e remover se carregado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "modprobe -n -v cramfs"
  expect      : "^install[[:space:]]+/bin/(true|false)"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "002, Bloqueio squashfs, Alta"
  info        : "Reduz superfície de ataque associada a arquivos comprimidos montados indevidamente"
  solution    : "Bloquear módulo via modprobe.d e remover se carregado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "modprobe -n -v squashfs"
  expect      : "^install[[:space:]]+/bin/(true|false)"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "003, Bloqueio udf, Alta"
  info        : "Evita uso de mídias ópticas como vetor de execução ou exfiltração de dados"
  solution    : "Bloquear módulo via modprobe.d e remover se carregado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "modprobe -n -v udf"
  expect      : "^install[[:space:]]+/bin/(true|false)"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "004, Bloqueio hfs, Alta"
  info        : "Remove suporte a filesystem Apple antigo que não é necessário em servidores Linux"
  solution    : "Bloquear módulo via modprobe.d e remover se carregado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "modprobe -n -v hfs"
  expect      : "FATAL: Module hfs not found|^install[[:space:]]+/bin/(true|false)"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "005, Bloqueio hfsplus, Alta"
  info        : "Remove suporte a filesystem Apple moderno que não agrega em ambiente de servidor"
  solution    : "Bloquear módulo via modprobe.d e remover se carregado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "modprobe -n -v hfsplus"
  expect      : "FATAL: Module hfsplus not found|^install[[:space:]]+/bin/(true|false)"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "006, Bloqueio jffs2, Alta"
  info        : "Elimina suporte a filesystem embarcado pouco usado e potencialmente mal auditado"
  solution    : "Bloquear módulo via modprobe.d e remover se carregado"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
