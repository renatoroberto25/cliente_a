<custom_item>
  type        : CMD_EXEC
  description : "035, Nodev removíveis, Média"
  info        : "Reduz risco de execução ou uso indevido de dispositivos externos"
  solution    : "Ajustar opções nodev,nosuid,noexec para mídias removíveis"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( out=$(findmnt -rn -o TARGET,OPTIONS | grep -E '/(media|mnt)' 2>/dev/null); [ -z \"$out\" ] || echo \"$out\" | grep -Eq 'nodev' && echo \"$out\" | grep -Eq 'nosuid' && echo \"$out\" | grep -Eq 'noexec'; ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "036, Nodev partições críticas, Média"
  info        : "Impede criação de dispositivos ou elevação via SUID em partições sensíveis"
  solution    : "Ajustar opções nodev,nosuid,noexec"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( out=$(findmnt -rn -o TARGET,OPTIONS | grep -E '^/(var|home|tmp|var/tmp|var/log|var/log/audit)\\\\b' 2>/dev/null); [ -z \"$out\" ] || echo \"$out\" | grep -Eq 'nodev' && echo \"$out\" | grep -Eq 'nosuid'; ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "040, Segurança /var/log, Alta"
  info        : "Impede uso indevido de dispositivos ou binários SUID em diretório de logs"
  solution    : "Ajustar opções nodev e nosuid"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( out=$(findmnt -n /var/log -o OPTIONS 2>/dev/null); [ -z \"$out\" ] || echo \"$out\" | grep -Eq 'nodev' && echo \"$out\" | grep -Eq 'nosuid'; ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "041, Segurança audit log, Alta"
  info        : "Protege diretório de auditoria contra execução indevida"
  solution    : "Ajustar opções nodev e nosuid"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( out=$(findmnt -n /var/log/audit -o OPTIONS 2>/dev/null); [ -z \"$out\" ] || echo \"$out\" | grep -Eq 'nodev' && echo \"$out\" | grep -Eq 'nosuid'; ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "042, Segurança /home, Alta"
  info        : "Reduz possibilidade de criação de dispositivos em diretórios de usuários"
  solution    : "Ajustar opções nodev"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "( findmnt -n /home -o OPTIONS 2>/dev/null | grep -Eq 'nodev' ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*pass\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "044, Sticky world-writable, Alta"
  info        : "Impede exclusão de arquivos por usuários não proprietários em diretórios compartilhados"
  solution    : "Aplicar opcoes seguras em midias removiveis"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "LC_ALL=C df --local -P | awk 'NR>1{print \\\\$6}' | sort -u | xargs -I{} find {} -xdev -type d -perm -0002 ! -perm -1000 2>/dev/null | wc -l"
  expect      : "^0$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "045, Sticky /tmp, Média"
  info        : "Protege arquivos temporários contra exclusão indevida por outros usuários"
  solution    : "Aplicar sticky bit em /tmp"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "stat -c '%a' /tmp 2>/dev/null"
  expect      : "^1[0-7][0-7][0-7]$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "046, Sticky /var/tmp, Média"
  info        : "Garante proteção semelhante ao /tmp para área temporária persistente"
  solution    : "Aplicar sticky bit em /var/tmp"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "stat -c '%a' /var/tmp 2>/dev/null"
  expect      : "^1[0-7][0-7][0-7]$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "047, Sticky /dev/shm, Alta"
  info        : "Protege memória compartilhada contra manipulação indevida quando exigido"
  solution    : "Aplicar sticky bit em /dev/shm quando aplicável"
  reference   : "01_Baseline_default.csv / AUDIT_SH/audit.sh"
  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "stat -c '%a' /dev/shm 2>/dev/null"
  expect      : "^1[0-7][0-7][0-7]$"
</custom_item>

