  see_also    : "AUDIT_SH/audit.sh"
  cmd         : "bash -c 'audit_grep() { local pattern=\"$1\"; shift; grep -REiq -- \"$pattern\" \"$@\" 2>/dev/null && echo PASS || echo FAIL; }; export -f audit_grep; audit_grep \"\\bexecve\\b\" /etc/audit/rules.d'"
  expect      : "(?i)^\\s*pass\\s*$"
