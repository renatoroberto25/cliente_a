  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 152 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -q 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' /root/.bash_profile && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "153, umask 027, Alta"
  info        : "Define criação padrão de arquivos e diretórios com permissões mais restritivas."
  solution    : "Configurar umask restritiva padrão."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 153 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Rqs 'umask 027' /etc/profile /etc/bashrc /etc/profile.d 2>/dev/null && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "154, TMOUT 900, Baixa"
  info        : "Encerra sessões inativas de shell reduzindo exposição por abandono de terminal."
