<custom_item>
  type        : CMD_EXEC
  description : "195, Verificar existência de arquivos órfãos (UID/GID sem dono), Baixa"
  info        : "Evita presença de arquivos locais sem proprietário válido."
  solution    : "Corrigir arquivos órfãos."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 195 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( find -xdev \\( -nouser -o -nogroup \\) 2>/dev/null | grep -q . ) && echo \"FAIL\" || echo \"PASS\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "196, Verificar world-writable fora de áreas permitidas, Média"
  info        : "Impede exclusão indevida em diretórios compartilhados com escrita global."
  solution    : "Garantir sticky bit em diretórios world writable."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 196 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( find -xdev \\( -type f -o -type d \\) -not -path \"/tmp/*\" -not -path \"/var/tmp/*\" -not -path \"/dev/shm/*\" -perm -0002 2>/dev/null | grep -q . ) && echo \"FAIL\" || echo \"PASS\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "197, Verificar arquivos/diretórios sem owner ou group, Média"
  info        : "Evita presença de arquivos locais sem owner ou grupo válido."
  solution    : "Corrigir arquivos sem owner ou grupo."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 197 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( find -xdev \\( -nouser -o -nogroup \\) 2>/dev/null | grep -q . ) && echo \"FAIL\" || echo \"PASS\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "198, Verificar binários SUID/SGID indevidos, Alta"
  info        : "Garante que SUID/SGID estejam configurados corretamente."
  solution    : "Ajustar permissões de arquivos executáveis."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 198 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( find -xdev \\( -perm -4000 -o -perm -2000 \\) 2>/dev/null | grep -Ev '^(/usr/bin/sudo|/usr/bin/su|/bin/su|/usr/bin/passwd|/usr/bin/chage|/usr/bin/chsh|/usr/bin/chfn|/usr/bin/newgrp|/usr/bin/gpasswd|/usr/sbin/unix_chkpwd|/usr/sbin/pam_timestamp_check|/usr/bin/mount|/usr/bin/umount|/usr/bin/fusermount|/usr/bin/pkexec|/usr/bin/crontab|/usr/bin/ssh-agent|/usr/bin/ksu|/usr/libexec/openssh/ssh-keysign|/usr/bin/ping|/usr/bin/ping6|/usr/bin/traceroute|/usr/bin/traceroute6)$' | grep -q . ) && echo \"FAIL\" || echo \"PASS\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "199, Verificar se usuários possuem diretório home válido), Baixa"
  info        : "Evita contas locais interativas sem diretório home válido."
  solution    : "Verificar usuários sem diretório home."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 199 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( awk -F: '$3>=1000 && $1!=\"nfsnobody\"{print $6}' /etc/passwd | while read -r h; do [ -d \"$h\" ] || exit 1; done ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "200, Verificar ownership das homes dos usuários, Média"
  info        : "Garante que cada diretório home pertença ao usuário esperado."
  solution    : "Ajustar ownership dos diretórios home."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 200 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( awk -F: '$3>=1000 && $1!=\"nfsnobody\"{print $1,$6}' /etc/passwd | while read -r u h; do [ -d \"$h\" ] && [ \"$(stat -Lc %U \"$h\")\" = \"$u\" ] || exit 1; done ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "201, Verificar permissões das homes (<=750), Média"
  info        : "Evita diretórios home com permissões excessivas."
  solution    : "Ajustar permissões de home para 750."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 201 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( awk -F: '$3>=1000 && $1!=\"nfsnobody\"{print $6}' /etc/passwd | while read -r h; do [ -d \"$h\" ] && [ \"$(stat -Lc %a \"$h\")\" -le 750 ] || exit 1; done ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "202, Verificar dotfiles inseguros nas homes, Baixa"
  info        : "Evita exposição ou alteração indevida de arquivos ocultos em home."
  solution    : "Ajustar permissões de dotfiles."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 202 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( while read -r h; do [ -d \"$h\" ] || continue; find \"$h\" -maxdepth 1 -type f -name \".*\" -perm /022 2>/dev/null; done < <(awk -F: '$3>=1000 && $1!=\"nfsnobody\"{print $6}' /etc/passwd) | grep -q . ) && echo \"FAIL\" || echo \"PASS\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "203, Verificar arquivos .forward/.netrc/.rhosts nas homes, Média"
  info        : "Evita mecanismos legados inseguros em diretórios home."
  solution    : "Remover arquivos .forward .netrc, .rhosts."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 203 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( while read -r h; do [ -d \"$h\" ] || continue; for f in \"$h/.forward\" \"$h/.netrc\" \"$h/.rhosts\"; do [ -e \"$f\" ] && echo \"$f\"; done; done < <(awk -F: '$3>=1000 && $1!=\"nfsnobody\"{print $6}' /etc/passwd) | grep -q . ) && echo \"FAIL\" || echo \"PASS\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "999, Verificação de hardening aplicado (log local)"
  info        : "Verifica se existe log local de execução do hardening e mostra o último registro."
  solution    : "Executar a automação de hardening para criar /var/log/hitss-hardening.log."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Controle operacional"
  see_also    : "/var/log/hitss-hardening.log"
  cmd         : "sh -c 'log=/var/log/hitss-hardening.log; [ -f \"$log\" ] || { echo \"FAIL | sem_log\"; exit; }; echo \"PASS | $(tail -n 1 \"$log\")\"'"
  expect      : "(?i)^\\s*PASS\\s*\\|"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "1000, Verificacao de artefatos gerenciados pelo hardening HITSS"
  info        : "Procura somente nos caminhos exatos criados pelos scripts de remediacao. A presenca de qualquer arquivo e evidencia direta da automacao, mesmo sem o log do executor."
  solution    : "Validar o artefato encontrado e o historico de execucao da automacao antes de qualquer remocao ou reaplicacao."
  reference   : "HARDENING HITSS RHEL - REMED_SH 01, 10, 11, 15 e 16"
  see_also    : "/etc/{modprobe.d,sysctl.d,security/limits.d,profile.d,sudoers.d,audit/rules.d}"
  cmd         : "sh -c 'hits=; for f in /etc/modprobe.d/99-hitss-hardening.conf /etc/sysctl.d/99-hitss-hardening.conf /etc/security/limits.d/99-hitss-coredump.conf /etc/sysctl.d/99-hitss-network.conf /etc/modprobe.d/99-hitss-wireless.conf /etc/profile.d/99-hitss-umask.sh /etc/profile.d/99-hitss-tmout.sh /etc/sudoers.d/99-hitss-hardening /etc/audit/rules.d/99-hitss-hardening.rules; do [ -e \"$f\" ] && hits=\"$hits $f\"; done; [ -n \"$hits\" ] && echo \"PASS | artefatos:$hits\" || echo \"FAIL | nenhum_artefato_hitss\"'"
  expect      : "(?i)^\\s*PASS\\s*\\|"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "1001, Verificacao de vestigios legados dos scripts de remediacao HITSS"
  info        : "Procura backups, arquivos desativados e temporarios com o sufixo exclusivo .hitss deixado pelos remed antigos, inclusive quando o executor ainda nao gravava log central."
  solution    : "Preservar a evidencia encontrada e correlacionar seu timestamp com a janela de hardening; nao excluir automaticamente."
  reference   : "HARDENING HITSS RHEL - funcao backup_file dos REMED_SH"
  see_also    : "Sufixos .hitss.bak.*, .hitss.disabled.* e .hitss.tmp.*"
  cmd         : "sh -c 'hit=; for d in /etc /boot; do [ -d \"$d\" ] || continue; hit=$(find \"$d\" -xdev -type f \\( -name \"*.hitss.bak.*\" -o -name \"*.hitss.disabled.*\" -o -name \"*.hitss.tmp.*\" \\) -print -quit 2>/dev/null); [ -n \"$hit\" ] && break; done; if [ -z \"$hit\" ]; then for d in /root /home; do [ -d \"$d\" ] || continue; hit=$(find \"$d\" -xdev -maxdepth 2 -type f \\( -name \"*.hitss.bak.*\" -o -name \"*.hitss.disabled.*\" -o -name \"*.hitss.tmp.*\" \\) -print -quit 2>/dev/null); [ -n \"$hit\" ] && break; done; fi; [ -n \"$hit\" ] && echo \"PASS | vestigio=$hit\" || echo \"FAIL | nenhum_vestigio_hitss\"'"
  expect      : "(?i)^\\s*PASS\\s*\\|"
</custom_item>

</check_type>
