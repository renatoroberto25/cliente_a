</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "162, Journald configurado persistente, Média"
  info        : "Mantém persistência de logs locais no journald."
  solution    : "Configurar journald com persistência."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 162 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -q '^Storage=persistent' /etc/systemd/journald.conf && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "164, Logrotate para rsyslog, Baixa"
  info        : "Mantém retenção e renovação periódica dos logs locais."
  solution    : "Configurar rotação de logs."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 164 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( grep -Eq 'rsyslog' /etc/logrotate.d/* 2>/dev/null ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "166, Auditoria antes do auditd(se utilizado), Alta"
  info        : "Garante inicialização do auditd(se utilizado) em fase adequada do boot."
  solution    : "Garantir auditd(se utilizado) antes de serviços críticos."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 166 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -q 'audit=1' /proc/cmdline && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "167, Tamanho de armazenamento de audit log, Média"
  info        : "Define tamanho máximo do arquivo de auditoria antes de ação rotativa."
  solution    : "Configurar max_log_file."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 167 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( grep -Eq '^\\s*max_log_file\\s*=\\s*[1-9]' /etc/audit/auditd.conf ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "168, Logs de auditoria não excluídos automaticamente, Alta"
  info        : "Preserva evidências de auditoria por retenção ou rotação controlada dos logs."
  solution    : "Configurar max_log_file_action como keep_logs ou rotate e dimensionar espaço e retenção."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 168 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( grep -Eq '^\\s*max_log_file_action\\s*=\\s*(keep_logs|rotate)' /etc/audit/auditd.conf ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "169, Auditoria de alterações em data/hora, Média"
