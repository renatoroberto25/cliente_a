<custom_item>
  type        : CMD_EXEC
  description : "193, Verificar se contas usam shell nologin, Média"
  info        : "Verifica a adoção de shell nologin para contas que não devem iniciar sessão interativa."
  solution    : "Revisar contas de serviço e atribuir /sbin/nologin ou /usr/sbin/nologin somente quando login interativo não for necessário."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 193 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( awk -F: '$7 ~ /(\\/usr)?\\/sbin\\/nologin$/ {found=1} END{exit !found}' /etc/passwd ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

