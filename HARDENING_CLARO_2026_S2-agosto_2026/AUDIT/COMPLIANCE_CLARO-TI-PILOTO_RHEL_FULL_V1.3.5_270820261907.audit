  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*X11Forwarding[[:space:]]+no' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "113, MaxAuthTries limitado, Média"
  info        : "Limita tentativas de autenticação por conexão SSH."
  solution    : "Configurar MaxAuthTries de forma restritiva."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 113 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*MaxAuthTries[[:space:]]+[1-4]$' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "114, IgnoreRhosts habilitado, Alta"
  info        : "Impede uso de mecanismos rhosts inseguros na autenticação SSH."
  solution    : "Configurar IgnoreRhosts yes."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 114 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*IgnoreRhosts[[:space:]]+yes' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "115, HostbasedAuthentication desabilitado, Alta"
  info        : "Evita autenticação baseada em host no SSH."
  solution    : "Configurar HostbasedAuthentication no."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 115 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*HostbasedAuthentication[[:space:]]+no' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "117, PermitEmptyPasswords desabilitado, Alta"
  info        : "Impede autenticação SSH com senha vazia."
  solution    : "Configurar PermitEmptyPasswords no."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 117 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*PermitEmptyPasswords[[:space:]]+no' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "118, PermitUserEnvironment desabilitado, Média"
  info        : "Impede influência de variáveis de ambiente definidas pelo usuário na sessão SSH."
  solution    : "Configurar PermitUserEnvironment no."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 118 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*PermitUserEnvironment[[:space:]]+no' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "119, UsePAM habilitado, Alta"
  info        : "Integra o SSH à stack PAM definida pela política."
  solution    : "Configurar UsePAM yes."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 119 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*UsePAM[[:space:]]+yes' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "120, Idle timeout configurado, Baixa"
  info        : "Encerra sessões inativas reduzindo risco de hijacking."
  solution    : "Ajustar ClientAliveInterval e ClientAliveCountMax."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 120 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*ClientAliveInterval[[:space:]]+([1-9][0-9]|[1-2][0-9]{2}|300)$' /etc/ssh/sshd_config  && grep -Eq '^[[:space:]]*ClientAliveCountMax[[:space:]]+[1-3]$' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "121, LoginGraceTime curto, Média"
  info        : "Limita tempo disponível para autenticação reduzindo exposição a brute force."
  solution    : "Configurar LoginGraceTime restritivo."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 121 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*LoginGraceTime[[:space:]]+([1-9][0-9]|[1-5][0-9]{2})s?$' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "122, MaxStartups/MaxSessions limitados, Média"
  info        : "Limita conexões simultâneas prevenindo exaustão de recursos."
  solution    : "Configurar MaxStartups e MaxSessions restritivos."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 122 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*MaxStartups[[:space:]]+.+$' /etc/ssh/sshd_config  && grep -Eq '^[[:space:]]*MaxSessions[[:space:]]+[1-9]+' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "123, AllowTcpForwarding restrito, Média"
  info        : "Garante que o AllowTcpForwarding esteja desabilitado."
  solution    : "Configurar AllowTcpForwarding no arquivo /etc/ssh/sshd_config."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 123 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*AllowTcpForwarding[[:space:]]+no' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "125, Ciphers fortes, Alta"
  info        : "Remove cifras SSH fracas e prioriza algoritmos resistentes."
  solution    : "Definir cifras aprovadas ou usar a política criptográfica do sistema; validar compatibilidade antes de recarregar o sshd."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 125 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*Ciphers[[:space:]]+.*(chacha20|aes256).*' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "126, MACs fortes, Alta"
  info        : "Remove algoritmos MAC fracos da negociação SSH."
  solution    : "Definir MACs aprovados ou herdar a política criptográfica do sistema e validar clientes."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 126 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*MACs[[:space:]]+.*(hmac-sha2|umac).*' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "127, KexAlgorithms fortes, Alta"
  info        : "Restringe a troca de chaves SSH a algoritmos fortes."
  solution    : "Definir KexAlgorithms aprovados ou usar a política criptográfica do sistema e testar clientes."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 127 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq '^[[:space:]]*KexAlgorithms[[:space:]]+.*(curve25519|diffie-hellman-group-exchange-sha256).*' /etc/ssh/sshd_config) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "130, pwquality habilitado, Alta"
  info        : "Garante aplicação de requisitos mínimos de robustez de senha."
  solution    : "Incluir módulo de complexidade na stack PAM."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 130 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Eq 'pam_pwquality\\.so' /etc/pam.d/*auth && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "131, Verificar parâmetros do pam_pwquality, Alta"
  info        : "Define critérios técnicos mínimos para criação de senhas seguras."
  solution    : "Configurar pam_pwquality conforme baseline."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 131 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( grep -Eq 'pam_pwquality\\.so' /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null && grep -Psiq '^\\s*minlen\\s*=\\s*(1[4-9]|[2-9][0-9]+)\\b' /etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf 2>/dev/null && grep -Psiq '^\\s*minclass\\s*=\\s*[4-9]\\b' /etc/security/pwquality.conf /etc/security/pwquality.conf.d/*.conf 2>/dev/null ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "132, pam_faillock habilitado, Alta"
  info        : "Garante que o pam_faillock esteja habilitado."
  solution    : "Configurar pam_faillock no arquivo /etc/pam.d/system-auth e /etc/pam.d/password-auth."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 132 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq 'pam_faillock\\.so' /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "133, pam_tally2 NÃO deve existir em RHEL 8/9, Alta"
  info        : "Garante que o pam_tally2 esteja inexistente."
  solution    : "Remover pam_tally2 das configurações PAM e manter mecanismo de bloqueio compatível com a política do baseline."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 133 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "! grep -Eq 'pam_tally2\\.so' /etc/pam.d/*auth && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "134, pam_pwhistory habilitado, Alta"
  info        : "Evita reutilização de senhas previamente utilizadas."
  solution    : "Configurar pam_pwhistory."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 134 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq 'pam_pwhistory\\.so' /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "135, minlen ≥ 14, Alta"
  info        : "Aumenta entropia mínima exigida para contas locais."
  solution    : "Definir tamanho mínimo de senha."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 135 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Psiq '^\\s*minlen\\s*=\\s*(1[4-9]|[2-9][0-9]+)' /etc/security/pwquality.conf* && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "136, minclass ≥ 4, Alta"
  info        : "Exige combinação de classes de caracteres reduzindo previsibilidade."
  solution    : "Configurar complexidade mínima de senha."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 136 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Psiq '^\\s*minclass\\s*=\\s*[4-9]' /etc/security/pwquality.conf* && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "137, maxrepeat & maxsequence = 3, Média"
  info        : "Impede uso de padrões triviais repetitivos ou sequenciais."
  solution    : "Configurar limites de repetição e sequência."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 137 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Psiq '^\\s*maxrepeat\\s*=\\s*3\\b'   /etc/security/pwquality.conf* && grep -Psiq '^\\s*maxsequence\\s*=\\s*3\\b' /etc/security/pwquality.conf* && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "138, dictcheck != 0, Média"
  info        : "Evita uso de palavras comuns facilmente descobertas."
  solution    : "Habilitar verificação de dicionário quando aplicável."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 138 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "! grep -Psiq '^\\s*dictcheck\\s*=\\s*0\\b' /etc/security/pwquality.conf* && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "139, Hashing sha512/yescrypt, Alta"
  info        : "Protege senhas armazenadas contra ataques offline."
  solution    : "Configurar algoritmo de hashing forte."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 139 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Eq 'pam_unix\\.so.*(sha512|yescrypt)' /etc/pam.d/*auth && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "140, pwhistory remember ≥ 5, Alta"
  info        : "Evita reuso imediato de credenciais antigas."
  solution    : "Configurar histórico de senha."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 140 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(grep -Eq 'pam_pwhistory\\.so.*remember=([5-9]|[1-9][0-9]+)' /etc/pam.d/system-auth /etc/pam.d/password-auth 2>/dev/null) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "141, deny maior igual a 5 (faillock), Alta"
  info        : "Limita tentativas consecutivas de autenticação por meio do pam_faillock."
  solution    : "Configurar deny conforme política em /etc/security/faillock.conf, aplicar via authselect e testar login local, SSH e sudo."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 141 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Pi '^\\s*deny\\s*=\\s*([5-9]|[1-9][0-9]+)' /etc/security/faillock.conf && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "142, unlock_time maior igual a 900, Alta"
  info        : "Define período de bloqueio adequado equilibrando segurança e usabilidade."
  solution    : "Configurar tempo de desbloqueio conforme política."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 142 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Pi '^\\s*unlock_time\\s*=\\s*(9[0-9]{2}|[1-9][0-9]{3,})\\b' /etc/security/faillock.conf && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "143, PASS_MAX_DAYS ≤ 365, Alta"
  info        : "Força renovação periódica de credenciais."
  solution    : "Configurar PASS_MAX_DAYS."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 143 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "val=$(awk '$1==\"PASS_MAX_DAYS\"{print $2; exit}' /etc/login.defs); [[ \"$val\" =~ ^[0-9]+$ ]] && [[ \"$val\" -le 365 ]] && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "144, PASS_MIN_DAYS maior igual a 1, Baixa"
  info        : "Evita trocas sucessivas de senha para burlar histórico."
  solution    : "Configurar PASS_MIN_DAYS."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 144 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Eq '^\\s*PASS_MIN_DAYS\\s+[1-9][0-9]*' /etc/login.defs && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "145, PASS_WARN_AGE maior igual a 7, Baixa"
  info        : "Notifica usuários antes da expiração evitando bloqueios inesperados."
  solution    : "Configurar PASS_WARN_AGE."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 145 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Eq '^\\s*PASS_WARN_AGE\\s+([7-9]|[1-9][0-9]+)' /etc/login.defs && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "146, inactive maior igual a 30 (para contas válidas), Alta"
  info        : "Define inativação automática de contas locais após expiração da senha."
  solution    : "Configurar parâmetro INACTIVE para contas locais."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 146 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "awk -F: '$2~/^\\$/ && ($7==\"\" || $7<30){exit 1}' /etc/shadow && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "147, campo 3 diferente 0, Alta"
  info        : "Evita contas locais ativas com data de última troca de senha no futuro."
  solution    : "Corrigir datas inconsistentes de troca de senha."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 147 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "awk -F: '$2~/^\\$/{if($3==\"\"||$3==0) exit 1} END{exit 0}' /etc/shadow && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "148, Root é o único UID 0, Alta"
  info        : "Evita existência de contas privilegiadas adicionais com UID 0."
  solution    : "Garantir apenas root com UID 0."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 148 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "awk -F: '($3==0 && $1!=\"root\"){exit 1}' /etc/passwd && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "149, Root é o único GID 0, Alta"
  info        : "Evita existência de grupos privilegiados adicionais com GID 0."
  solution    : "Garantir apenas grupo root com GID 0."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 149 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "[ \"$(awk -F: '/^root:/ {print $4}' /etc/passwd)\" = \"0\" ] && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "150, Contas de sistema com shell interativo, Alta"
  info        : "Evita login interativo em contas de sistema."
  solution    : "Bloquear contas de sistema com shell inválido."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 150 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "awk -F: '($3<1000 && $1!=\"root\" && $7 ~ /(bash|sh|zsh)$/){exit 1}' /etc/passwd && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "151, /sbin/nologin presente em /etc/shells, Baixa"
  info        : "Evita exposição de shells não aprovados no sistema."
