  see_also    : "CONSULTAR BASELINE"
  cmd         : "( auditctl -l 2>/dev/null | grep -Eq 'sethostname|setdomainname|/etc/hosts|/etc/hostname' ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "173, Auditoria de login/logout, Média"
  info        : "Registra eventos de autenticação e sessão."
  solution    : "Auditar eventos de login."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 173 Classificação de automação, Light"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "( auditctl -l 2>/dev/null | grep -Eq '/var/log/faillog|/var/log/lastlog|/var/run/utmp' ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "174, Auditoria de permissões DAC, Média"
  info        : "Registra mudanças relevantes de permissões e propriedades."
  solution    : "Auditar mudanças de permissões."
