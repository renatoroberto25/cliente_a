<check_type:"Unix">

<custom_item>
  type        : CMD_EXEC
  description : "001, Verifique se o módulo do kernel do CRAMFS não está disponível, Baixa"
  info        : "Reduz superfície de ataque removendo suporte a filesystem legado raramente necessário."
  solution    : "Bloquear módulo via modprobe.d e remover se carregado."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 001 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(modinfo cramfs &>/dev/null && modprobe --showconfig | grep -Pq '\\b(install|blacklist)\\h+cramfs\\b' && ! lsmod | grep -q cramfs) || (! modinfo cramfs &>/dev/null) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "002, Verifique se o módulo do kernel do SQUASHFS não está disponível, Baixa"
  info        : "Reduz superfície de ataque associada a arquivos comprimidos montados indevidamente."
  solution    : "Bloquear módulo via modprobe.d e remover se carregado."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 002 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "(modinfo squashfs &>/dev/null && modprobe --showconfig | grep -Pq '\\b(install|blacklist)\\h+squashfs\\b' && ! lsmod | grep -q squashfs) || (! modinfo squashfs &>/dev/null) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

