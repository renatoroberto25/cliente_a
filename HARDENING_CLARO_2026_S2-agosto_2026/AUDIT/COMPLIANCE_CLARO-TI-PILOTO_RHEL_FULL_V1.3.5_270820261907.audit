  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 151 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -qE '^(\\/usr)?\\/sbin\\/nologin$' /etc/shells && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "152, PATH do root configurado, Alta"
  info        : "Evita uso de diretório corrente no PATH do root."
