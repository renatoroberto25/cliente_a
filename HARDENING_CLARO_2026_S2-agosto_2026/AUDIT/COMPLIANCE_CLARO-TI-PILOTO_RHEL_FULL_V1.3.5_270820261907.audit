  see_also    : "CONSULTAR BASELINE"
  cmd         : "( auditctl -l 2>/dev/null | grep -Eq 'adjtimex|settimeofday|clock_settime' ) && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "170, Auditoria de alterações em contas/grupos, Média"
  info        : "Registra alterações em arquivos críticos de contas e grupos."
  solution    : "Auditar alterações de contas e grupos."
