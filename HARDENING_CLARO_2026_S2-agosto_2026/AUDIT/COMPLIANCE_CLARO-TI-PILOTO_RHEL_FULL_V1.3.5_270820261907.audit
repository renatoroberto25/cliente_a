  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "171, Auditoria de alterações no ambiente de rede, Média"
  info        : "Registra alterações em arquivos críticos de configuração de rede."
  solution    : "Auditar alterações de rede."
