  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 154 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -Rqs 'TMOUT=900' /etc/profile /etc/bashrc /etc/profile.d 2>/dev/null && echo \"PASS\" || echo \"FAIL\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "155, Ausência de regras amplas sudo, Alta"
  info        : "Centraliza privilégio administrativo em grupo autorizado."
  solution    : "Restringir administração privilegiada via sudo."
  reference   : "BASELINE-TO-JIRA_CLARO_TI Tópico 155 Classificação de automação, Full"
  see_also    : "CONSULTAR BASELINE"
  cmd         : "grep -RqsE '^%.*ALL=\\(ALL\\)' /etc/sudoers /etc/sudoers.d 2>/dev/null && echo \"FAIL\" || echo \"PASS\""
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "156, sudo usa pty, Alta"
  info        : "Associa execução privilegiada a terminal interativo."
