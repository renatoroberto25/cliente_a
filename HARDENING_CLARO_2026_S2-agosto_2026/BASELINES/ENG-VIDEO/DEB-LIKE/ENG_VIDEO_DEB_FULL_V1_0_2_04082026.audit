<custom_item>
  type        : CMD_EXEC
  description : "123, Contas de sistema com shell inválido bloqueadas, Alta"
  info        : "Evita login interativo em contas de sistema."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( uid_min=$(awk '$1==\"UID_MIN\"{print $2; exit}' /etc/login.defs); awk -F: -v m=\"${uid_min:-1000}\" '$1 !~ /^(root|sync|shutdown|halt)$/ && $3<m && $7 !~ /(nologin|false)$/ {bad=1} END{exit bad}' /etc/passwd ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "124, /etc/shells validado, Baixa"
  info        : "Evita exposição de shells não aprovados no sistema."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( awk '!/^[[:space:]]*(#|$)/{print}' /etc/shells | while read -r s; do [ -x \"$s\" ] && [ \"$(stat -Lc %u \"$s\")\" -eq 0 ] && [ $((8#$(stat -Lc %a \"$s\") & 0022)) -eq 0 ] || exit 1; done ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "125, PATH do root sem diretório inseguro, Alta"
  info        : "Evita uso de diretório corrente no PATH do root."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( p=$(getent passwd root | cut -d: -f7); path=$(env -i HOME=/root \"$p\" -lc 'printf %s \"$PATH\"' 2>/dev/null); oldifs=$IFS; IFS=:; for d in $path; do [ -n \"$d\" ] && [ \"$d\" != . ] && [ -d \"$d\" ] && [ \"$(stat -Lc %u \"$d\")\" -eq 0 ] && [ $((8#$(stat -Lc %a \"$d\") & 0022)) -eq 0 ] || exit 1; done; IFS=$oldifs ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "126, Umask padrão restritiva, Alta"
  info        : "Define criação padrão de arquivos e diretórios com permissões mais restritivas."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( grep -REq '^[[:space:]]*umask[[:space:]]+0(27|77)([[:space:]]|$)' /etc/profile /etc/bash.bashrc /etc/profile.d/*.sh 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "127, Timeout de shell, Baixa"
  info        : "Encerra sessões inativas de shell reduzindo exposição por abandono de terminal. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( grep -REq '^[[:space:]]*TMOUT=([1-8]?[0-9]{1,2}|900)([[:space:]]|$)' /etc/profile /etc/bash.bashrc /etc/profile.d/*.sh 2>/dev/null && grep -REq '^[[:space:]]*(readonly|export)[[:space:]]+TMOUT' /etc/profile /etc/bash.bashrc /etc/profile.d/*.sh 2>/dev/null ) && echo PASS || echo NA && echo PASS || echo NA && echo PASS || echo NA"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "128, Administração privilegiada via sudo restrita, Alta"
  info        : "Centraliza privilégio administrativo em grupo autorizado."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then ( grep -REq '^[[:space:]]*%sudo[[:space:]]+ALL[[:space:]]*=[[:space:]]*\\(ALL(:ALL)?\\)[[:space:]]+ALL([[:space:]]|$)' /etc/sudoers /etc/sudoers.d/* 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "129, Sudo com pseudo-TTY, Alta"
  info        : "Reduz riscos de execução de sudo sem terminal controlado e melhora a rastreabilidade."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then ( grep -REq '^[[:space:]]*Defaults([[:space:]]+|:)[^#]*use_pty([[:space:],]|$)' /etc/sudoers /etc/sudoers.d/* 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "131, Timeout de autenticação sudo, Baixa"
  info        : "Limita tempo de reaproveitamento de credencial sudo."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then if command -v sudo >/dev/null 2>&1 && [ -f /etc/sudoers ]; then ( v=$(grep -REh '^[[:space:]]*Defaults([[:space:]]+|:)[^#]*timestamp_timeout=' /etc/sudoers /etc/sudoers.d/* 2>/dev/null | tail -1 | sed -E 's/.*timestamp_timeout=([0-9]+).*/\\1/'); [ -n \"$v\" ] && [ \"$v\" -ge 0 ] && [ \"$v\" -le 15 ] ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "132, Uso de su restrito por grupo, Média"
  info        : "Impede que usuários fora dos grupos autorizados tentem elevar privilégios por meio do comando su."
  solution    : "Configurar em /etc/pam.d/su uma regra PAM obrigatória que restrinja o uso de su a grupo aprovado pelo responsável do sistema. Validar o grupo pelo mecanismo de identidade e testar o acesso com uma conta administrativa de contingência antes de encerrar a sessão."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "su_bin=$(command -v su 2>/dev/null); if [ -z \"$su_bin\" ] || [ ! -x \"$su_bin\" ]; then echo NA; elif [ ! -f /etc/pam.d/su ]; then echo FAIL; else wheel_rules=$(awk '!/^[[:space:]]*#/ && $1==\"auth\" && ($2==\"required\" || $2==\"requisite\") && $0 ~ /pam_wheel\\.so([[:space:]]|$)/' /etc/pam.d/su 2>/dev/null); succeed_rules=$(awk '!/^[[:space:]]*#/ && $1==\"auth\" && ($2==\"required\" || $2==\"requisite\") && $0 ~ /pam_succeed_if\\.so/ && $0 ~ /user[[:space:]]+ingroup[[:space:]]+[^[:space:]]+/' /etc/pam.d/su 2>/dev/null); rules=$(printf '%s\\n%s\\n' \"$wheel_rules\" \"$succeed_rules\" | sed '/^[[:space:]]*$/d'); rule_count=$(printf '%s\\n' \"$rules\" | grep -c .); if [ \"$rule_count\" -eq 0 ]; then echo FAIL; else ok=1; groups=''; explicit=$(printf '%s\\n' \"$wheel_rules\" | grep -oE 'group=[^[:space:]]+' | cut -d= -f2- | sort -u); succeed_groups=$(printf '%s\\n' \"$succeed_rules\" | sed -nE 's/.*user[[:space:]]+ingroup[[:space:]]+([^[:space:]]+).*/\\1/p' | sort -u); for group in $explicit $succeed_groups; do if getent group \"$group\" >/dev/null 2>&1; then groups=\"${groups}${groups:+,}$group\"; else ok=0; fi; done; implicit_count=$(printf '%s\\n' \"$wheel_rules\" | grep -c .); explicit_count=$(printf '%s\\n' \"$wheel_rules\" | grep -cE 'group=[^[:space:]]+'); if [ \"$implicit_count\" -gt \"$explicit_count\" ]; then if getent group wheel >/dev/null 2>&1; then implicit_group=wheel; else implicit_group=$(getent group 0 2>/dev/null | awk -F: 'NR==1{print $1}'); fi; if [ -n \"$implicit_group\" ]; then groups=\"${groups}${groups:+,}$implicit_group\"; else ok=0; fi; fi; [ \"$ok\" -eq 1 ] && echo \"PASS regras=$rule_count grupos=${groups:-grupo-padrao}\" || echo FAIL; fi; fi"
  expect      : "(?i)^\\s*(PASS(?:\\s+.*)?|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "133, Journald persistente, Média"
  info        : "Mantém persistência de logs locais no journald."
  solution    : "Ajustar journald, rsyslog, logrotate ou auditd conforme o item; validar retenção, espaco e inicialização do serviço."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if systemctl --version >/dev/null 2>&1; then ( cfg=$(systemd-analyze cat-config systemd/journald.conf 2>/dev/null | awk -F= '/^[[:space:]]*Storage[[:space:]]*=/{gsub(/[[:space:]]/,\"\",$2); v=tolower($2)} END{print v}'); { [ \"$cfg\" = persistent ] || { { [ -z \"$cfg\" ] || [ \"$cfg\" = auto ]; } && [ -d /var/log/journal ]; }; } ) && echo PASS || echo FAIL; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

