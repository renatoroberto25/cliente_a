<custom_item>
  type        : CMD_EXEC
  description : "033, Nodev removíveis, Média"
  info        : "Reduz risco de execução ou uso indevido de dispositivos externos. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Ajustar /etc/fstab ou unidade .mount com as opções requeridas; executar em janela com plano de rollback e validação de boot."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if findmnt -rn -o TARGET 2>/dev/null | grep -Eq '^/(media|mnt)(/|$)'; then if findmnt -rn -o TARGET 2>/dev/null | grep -Eq '^/(media|mnt)(/|$)'; then if findmnt -rn -o TARGET 2>/dev/null | grep -Eq '^/(media|mnt)(/|$)'; then ( out=$(findmnt -rn -o TARGET,OPTIONS | awk '$1 ~ \"^/(media|mnt)(/|$)\"'); [ -z \"$out\" ] || { ! echo \"$out\" | grep -Ev 'nodev' | grep -q . && ! echo \"$out\" | grep -Ev 'nosuid' | grep -q . && ! echo \"$out\" | grep -Ev 'noexec' | grep -q .; } ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
