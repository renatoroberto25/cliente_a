<custom_item>
  type        : CMD_EXEC
  description : "023, Partição dedicada para /tmp, Baixa"
  info        : "Garante que o diretório /tmp tenha sua própria partição para evitar uso excessivo de espaço em disco. A aplicabilidade depende da função do servidor e deve ser registrada no aceite do baseline."
  solution    : "Ajustar /etc/fstab ou unidade .mount com as opções requeridas; executar em janela com plano de rollback e validação de boot."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "( findmnt -rn -T /tmp -o TARGET 2>/dev/null | grep -qx /tmp ) && echo PASS || echo NA && echo PASS || echo NA && echo PASS || echo NA"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

