<custom_item>
  type        : CMD_EXEC
  description : "105, PAM complexidade, Alta"
  info        : "Garante aplicação de requisitos mínimos de robustez de senha."
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  see_also    : "01_Baseline_DEBLIKE_FULL_v1.0.0"
  cmd         : "if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then ( grep -Eq '^[[:space:]]*password[[:space:]].*pam_pwquality\\.so' /etc/pam.d/common-password 2>/dev/null ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

