<check_type:"Unix">

<custom_item>
  type        : CMD_EXEC
  description : "002, Bloqueio squashfs, Baixa"
  info        : "Verificar se módulo squashfs está bloqueado Validar conforme a função, a arquitetura e as exceções aprovadas para o servidor."
  solution    : "Criar regra em /etc/modprobe.d com install /bin/false e blacklist; descarregar o módulo somente após validar dependências."
  reference   : "03_Hardening_2026_DEBLIKE.xlsx"
  see_also    : "03_Hardening_2026_DEBLIKE.xlsx"
  cmd         : "if modinfo squashfs >/dev/null 2>&1; then if modinfo squashfs >/dev/null 2>&1; then if modinfo squashfs >/dev/null 2>&1; then ( ! modinfo squashfs >/dev/null 2>&1 || { modprobe -n -v squashfs 2>/dev/null | grep -Eq '^install[[:space:]]+(/usr)?/bin/(true|false)([[:space:]]|$)' && ! lsmod | awk '{print $1}' | grep -qx squashfs; } ) && echo PASS || echo NA; else echo NA; fi && echo PASS || echo NA; else echo NA; fi && echo PASS || echo NA; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

