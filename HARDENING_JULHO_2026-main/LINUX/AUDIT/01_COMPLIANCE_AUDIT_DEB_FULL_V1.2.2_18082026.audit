  description : "123, Contas de sistema com shell inválido bloqueadas, Alta"
  info        : "Verificar shells de contas de sistema"
  solution    : "Ajustar /etc/pam.d/common-* e arquivos em /etc/security; validar login local, SSH e sudo com conta administrativa de contingencia."
  reference   : "03_Hardening_2026_DEBLIKE.xlsx"
  see_also    : "03_Hardening_2026_DEBLIKE.xlsx"
  cmd         : "( uid_min=$(awk '$1==\"UID_MIN\"{print $2; exit}' /etc/login.defs); awk -F: -v m=\"${uid_min:-1000}\" '$1 !~ /^(root|sync|shutdown|halt)$/ && $3<m && $7 !~ /(nologin|false)$/ {bad=1} END{exit bad}' /etc/passwd ) && echo PASS || echo FAIL"
