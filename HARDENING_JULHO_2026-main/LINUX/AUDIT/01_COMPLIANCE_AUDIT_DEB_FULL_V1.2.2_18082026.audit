<custom_item>
  type        : CMD_EXEC
  description : "165, Usuários sem home inexistentes, Baixa"
  info        : "Procura a configuração de Usuários sem home inexistentes em /sbin/nologin, /etc/passwd. Saída conforme quando atende `(?i)^\\s*pass\\s*$`."
  solution    : "Corrigir proprietário e permissões preservando root:shadow onde previsto no Debian; revisar cada achado antes de alterar arquivos de aplicacao."
  reference   : "03_Hardening_2026_DEBLIKE.xlsx"
  see_also    : "03_Hardening_2026_DEBLIKE.xlsx"
  cmd         : "if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then ( uid_min=$(awk '$1==\"UID_MIN\"{print $2; exit}' /etc/login.defs); awk -F: -v m=\"${uid_min:-1000}\" '$3>=m && $7 !~ /(nologin|false)$/ {print $6}' /etc/passwd | while read -r h; do [ -d \"$h\" ] || exit 1; done ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

