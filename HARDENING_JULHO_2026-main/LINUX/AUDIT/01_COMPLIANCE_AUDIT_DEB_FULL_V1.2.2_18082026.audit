  reference   : "03_Hardening_2026_DEBLIKE.xlsx"
  see_also    : "03_Hardening_2026_DEBLIKE.xlsx"
  cmd         : "if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then if [ -f /etc/pam.d/common-password ] && [ -f /etc/shadow ] && grep -Eq 'pam_unix\\.so' /etc/pam.d/common-password 2>/dev/null && awk -F: 'NR==FNR {shell[$1]=$7; next} $2 ~ /^\\$(y|[156])\\$/ && shell[$1] !~ /(nologin|false)$/ {ok=1} END{exit !ok}' /etc/passwd /etc/shadow; then ( ! find /home -xdev -maxdepth 2 -type f \\( -name .forward -o -name .netrc -o -name .rhosts \\) -print -quit 2>/dev/null | grep -q . ) && echo PASS || echo FAIL; else echo NA; fi; else echo NA; fi; else echo NA; fi"
  expect      : "(?i)^\\s*(PASS|NA)\\s*$"
</custom_item>

<custom_item>
  type        : CMD_EXEC
  description : "999, Verificacao de hardening aplicado (log local)"
  info        : "Verifica se existe log local de execucao do hardening e mostra o ultimo registro."
  solution    : "Executar a automacao de hardening para criar /var/log/hitss-hardening.log."
  reference   : "EVIDENCIA_AUTOMACAO"
  see_also    : "/var/log/hitss-hardening.log"
  cmd         : "sh -c 'log=/var/log/hitss-hardening.log; [ -f \"$log\" ] || { echo \"FAIL | sem_log\"; exit; }; echo \"PASS | $(tail -n 1 \"$log\")\"'"
  expect      : "(?i)^\\s*PASS\\s*\\|"
</custom_item>

</check_type>
