<custom_item>
  type        : CMD_EXEC
  description : "019, perf_event restrito, Baixa"
  info        : "Lê o parâmetro sysctl kernel.perf_event_paranoid. Saída conforme quando atende `(?i)^\\s*pass\\s*$`."
  solution    : "Persistir o parâmetro em /etc/sysctl.d/99-hardening.conf e aplicar com sysctl --system após validar a rede e a carga de trabalho."
  reference   : "03_Hardening_2026_DEBLIKE.xlsx"
  see_also    : "03_Hardening_2026_DEBLIKE.xlsx"
  cmd         : "( v=$(sysctl -n kernel.perf_event_paranoid 2>/dev/null); [ -n \"$v\" ] && [ \"$v\" -ge \"2\" ] && grep -Eq '^[[:space:]]*kernel\\.perf_event_paranoid[[:space:]]*=[[:space:]]*[2-9][0-9]*([[:space:]]|$)' /etc/sysctl.d/99-hitss-hardening.conf 2>/dev/null && awk -F= -v key='kernel.perf_event_paranoid' -v expected='2' '{ name=$1; gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",name); if (name==key) { value=$2; sub(/[[:space:]]*[#;].*$/,\"\",value); gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",value) } } END { exit (value + 0) < (expected + 0) }' /etc/sysctl.conf 2>/dev/null ) && echo PASS || echo FAIL"
  expect      : "(?i)^\\s*PASS\\s*$"
</custom_item>

