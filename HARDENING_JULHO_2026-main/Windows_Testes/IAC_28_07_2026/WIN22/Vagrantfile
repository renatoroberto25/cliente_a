Vagrant.configure("2") do |config|
  data = Time.now.strftime("%Y%m%d")
  name = "win2022-#{data}"

  config.vm.box = "gusztavvargadr/windows-server-2022-standard"
  config.vm.box_version = "2601.0.0"

  config.vm.hostname = name

  config.vm.network "private_network", ip: "192.168.56.120"

  config.vm.provider "virtualbox" do |vb|
    vb.name   = name
    vb.memory = 4096
    vb.cpus   = 2
  end

end
